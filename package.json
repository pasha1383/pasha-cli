{
  "name": "@pasha1383/pasha",
  "version": "2.1.0",
  "description": "Multi-language / multi-architecture CLI generator — pick a stack, we scaffold the base project for you",
  "main": "bin/pasha.js",
  "bin": {
    "pasha": "./bin/pasha.js"
  },
  "author": "Parsa Shadkam",
  "license": "MIT",
  "keywords": [
    "cli",
    "generator",
    "scaffold",
    "hexagonal",
    "ddd",
    "clean-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pasha1383/pasha-cli.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "start": "node bin/pasha.js",
    "doctor": "node bin/pasha.js doctor",
    "link": "npm link",
    "unlink": "npm unlink -g @pasha1383/pasha",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "verify:tui": "node test/harness/walker.js --smoke",
    "verify:tui:full": "node test/harness/walker.js --full"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "lib/**/*.js"
    ]
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "fs-extra": "^11.3.5",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.7",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "node-pty": "^1.1.0"
  }
}
