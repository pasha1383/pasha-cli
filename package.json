{
  "name": "@pasha1383/pasha",
  "version": "3.0.0",
  "description": "Multi-language / multi-architecture CLI generator — pick a stack, we scaffold the base project for you",
  "main": "bin/pasha.js",
  "bin": {
    "pasha": "./bin/pasha.js"
  },
  "author": "Parsa Shadkam",
  "license": "MIT",
  "keywords": [
    "cli",
    "generator",
    "scaffold",
    "hexagonal",
    "ddd",
    "clean-architecture"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pasha1383/pasha-cli.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "files": [
    "bin",
    "src",
    "templates",
    "install.sh",
    "README.md"
  ],
  "scripts": {
    "doctor": "node bin/pasha.js doctor",
    "link": "npm link",
    "unlink": "npm unlink -g @pasha1383/pasha",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "validate:templates": "node tools/validate-templates.js",
    "verify": "npm test && npm run validate:templates && npm run verify:tui",
    "verify:tui": "node test/harness/walker.js --smoke",
    "verify:tui:full": "node test/harness/walker.js --full",
    "verify:tui:fuzz": "node test/harness/walker.js --fuzz",
    "verify:boot": "node test/harness/boot-tester.js",
    "verify:tui:snaps": "node test/harness/snapshot-tester.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "fs-extra": "^11.3.5",
    "handlebars": "^4.7.8",
    "ink": "^5.2.1",
    "ink-multi-select": "^2.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "ora": "^5.4.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "node-pty": "^1.1.0"
  }
}
