server:
  port: ${APP_PORT:8080}

spring:
  application:
    name: {{projectName}}
  {{#if hasDatabase}}
  datasource:
    {{#if dbPostgres}}
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/{{{shellDefault "DB_NAME" projectName}}}
    username: ${{{shellDefault "DB_USER" dbName}}}
    password: ${DB_PASSWORD:postgres}
    driver-class-name: org.postgresql.Driver
    {{/if}}
    {{#if dbMysql}}
    url: jdbc:mysql://${DB_HOST:localhost}:${DB_PORT:3306}/{{{shellDefault "DB_NAME" projectName}}}
    username: ${DB_USER:root}
    password: ${DB_PASSWORD:root}
    driver-class-name: com.mysql.cj.jdbc.Driver
    {{/if}}
    {{#if dbH2}}
    url: jdbc:h2:mem:{{projectName}};DB_CLOSE_DELAY=-1
    username: sa
    password:
    driver-class-name: org.h2.Driver
    {{/if}}
  {{/if}}
  {{#if ormJpa}}
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: false
    properties:
      hibernate:
        format_sql: true
    {{#if dbH2}}
    database-platform: org.hibernate.dialect.H2Dialect
    {{/if}}
  {{/if}}
  {{#if dbH2}}
  h2:
    console:
      enabled: true
      path: /h2-console
  {{/if}}
  {{#if useRedis}}
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}
  {{/if}}
  {{#if useKafka}}
  kafka:
    bootstrap-servers: ${KAFKA_BROKERS:localhost:9092}
    consumer:
      group-id: {{projectName}}-consumer
      auto-offset-reset: earliest
  {{/if}}
  {{#if useRabbitmq}}
  rabbitmq:
    host: ${RABBITMQ_HOST:localhost}
    port: ${RABBITMQ_PORT:5672}
    username: ${RABBITMQ_USER:guest}
    password: ${RABBITMQ_PASS:guest}
  {{/if}}

{{#if useAuth}}
app:
  jwt:
    secret: ${JWT_SECRET:change-me-to-a-long-random-string}
    expiration-ms: ${JWT_EXPIRATION_MS:3600000}
{{/if}}

{{#if useSwagger}}
springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /docs
{{/if}}

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      show-details: always
