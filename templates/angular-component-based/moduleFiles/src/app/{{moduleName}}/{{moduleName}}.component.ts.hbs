import { Component, signal } from '@angular/core';

@Component({
  selector: 'app-{{kebabCase moduleName}}',
  standalone: true,
  imports: [],
  template: `
    <div class="{{kebabCase moduleName}}">
      <h2>{{pascalCase moduleName}}</h2>
      <p class="count" [innerText]="count()"></p>
      <div class="actions">
        <button (click)="decrement()">-</button>
        <button (click)="reset()">Reset</button>
        <button (click)="increment()">+</button>
      </div>
    </div>
  `,
  styles: [`
    .{{kebabCase moduleName}} {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 1.5rem;
      text-align: center;
      margin-bottom: 1rem;
    }

    h2 {
      margin: 0 0 1rem;
      font-size: 1.25rem;
    }

    .count {
      font-size: 2rem;
      font-weight: bold;
      margin: 0.5rem 0;
      color: #2b6cb0;
    }

    .actions {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
    }

    button {
      padding: 0.5rem 1rem;
      border: 1px solid #cbd5e0;
      border-radius: 4px;
      background: #f7fafc;
      cursor: pointer;
      font-size: 1rem;
    }

    button:hover {
      background: #edf2f7;
    }
  `],
  changeDetection: 0,
})
export class {{pascalCase moduleName}}Component {
  count = signal(0);

  increment() {
    this.count.update((c) => c + 1);
  }

  decrement() {
    this.count.update((c) => c - 1);
  }

  reset() {
    this.count.set(0);
  }
}
