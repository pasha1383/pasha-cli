import { Routes } from '@angular/router';

export const appRoutes: Routes = [
  {
    path: '',
    redirectTo: '/home',
    pathMatch: 'full',
  },
  {
    path: 'home',
    loadComponent: () =>
      import('./home/home.component').then((m) => m.HomeComponent),
  },
  {{#each modules}}
  {
    path: '{{this}}',
    loadChildren: () =>
      import('./{{this}}/{{this}}.module').then((m) => m.{{pascalCase this}}Module),
  },
  {{/each}}
];
