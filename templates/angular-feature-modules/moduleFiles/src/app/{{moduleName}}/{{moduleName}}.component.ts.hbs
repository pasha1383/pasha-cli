import { Component, OnInit } from '@angular/core';
{{#if useZod}}
import { z } from 'zod';
{{/if}}

{{#if useZod}}
const {{camelCase moduleName}}Schema = z.object({
  id: z.string(),
  name: z.string().min(1),
});

type {{pascalCase moduleName}} = z.infer<typeof {{camelCase moduleName}}Schema>;
{{/if}}

@Component({
  selector: 'app-{{kebabCase moduleName}}',
  template: `
    <div class="{{kebabCase moduleName}}">
      <h2>{{pascalCase moduleName}}</h2>
      <p class="description">Feature module: <strong>{{moduleName}}</strong></p>
      <p class="counter" [innerText]="'Count: ' + count"></p>
      <div class="actions">
        <button (click)="decrement()">-</button>
        <button (click)="reset()">Reset</button>
        <button (click)="increment()">+</button>
      </div>
    </div>
  `,
  styles: [`
    .{{kebabCase moduleName}} {
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 1rem;
    }
    h2 { margin: 0 0 0.5rem; }
    .description { color: #718096; margin: 0 0 1rem; font-size: 0.9rem; }
    .counter { font-size: 2rem; font-weight: bold; color: #2b6cb0; margin: 0.5rem 0; text-align: center; }
    .actions { display: flex; gap: 0.5rem; justify-content: center; }
    button {
      padding: 0.5rem 1rem;
      border: 1px solid #cbd5e0;
      border-radius: 4px;
      background: #f7fafc;
      cursor: pointer;
      font-size: 1rem;
    }
    button:hover { background: #edf2f7; }
  `],
})
export class {{pascalCase moduleName}}Component implements OnInit {
  count = 0;

  constructor({{#if false}}private service: any{{/if}}) {}

  ngOnInit() {}

  increment() { this.count++; }
  decrement() { this.count--; }
  reset() { this.count = 0; }
}
