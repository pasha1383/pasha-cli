      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 1rem;
    }
    h2 { margin: 0 0 1rem; }
    ul { list-style: none; padding: 0; }
    li { padding: 0.5rem; border-bottom: 1px solid #edf2f7; }
    .error { color: #e53e3e; }
    button {
      padding: 0.5rem 1rem;
      border: 1px solid #cbd5e0;
      border-radius: 4px;
      background: #f7fafc;
      cursor: pointer;
      margin-top: 1rem;
    }
    button:hover { background: #edf2f7; }
  `],
  changeDetection: 0,
})
export class {{pascalCase moduleName}}Component implements OnInit {
  private store = inject(Store);

  items$: Observable<{{pascalCase moduleName}}[]> = this.store.select(selectAll{{pascalCase moduleName}}s);
  loading$ = this.store.select(select{{pascalCase moduleName}}sLoading);
  error$ = this.store.select(select{{pascalCase moduleName}}sError);

  ngOnInit() {
    this.store.dispatch({{pascalCase moduleName}}Actions.load{{pascalCase moduleName}}s());
  }

  addDemo() {
    const newItem: {{pascalCase moduleName}} = {
      id: crypto.randomUUID(),
      name: `Item ${Date.now()}`,
      createdAt: new Date().toISOString(),
