import { test, expect } from '@playwright/test';

test('home page loads', async ({ page }) => {
  await page.goto('/');
  await expect(page.locator('h1')).toBeVisible();
});

{{#each modules}}
test('{{this}} page loads', async ({ page }) => {
  await page.goto('/{{this}}');
  await expect(page.locator('h1')).toBeVisible();
});
{{/each}}
