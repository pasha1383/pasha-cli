{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@islands/*": ["./src/islands/*"],
      "@layouts/*": ["./src/layouts/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.astro", "src/**/*.svelte"]
}
