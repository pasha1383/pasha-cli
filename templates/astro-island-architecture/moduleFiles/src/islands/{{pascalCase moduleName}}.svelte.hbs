<script lang="ts">
  interface Props {
    title?: string;
    initialValue?: number;
  }

  let { title = '{{pascalCase moduleName}}', initialValue = 0 }: Props = $props();

  let count = $state(initialValue);
  let inputText = $state('');

  function increment() {
    count++;
  }

  function decrement() {
    count--;
  }

  function reset() {
    count = initialValue;
  }
</script>

<div class="{{kebabCase moduleName}}-island">
  <h3>{title}</h3>
  <p class="counter">{count}</p>

  <div class="actions">
    <button onclick={decrement}>-</button>
    <button onclick={reset}>Reset</button>
    <button onclick={increment}>+</button>
  </div>

  <div class="input-section">
    <input
      type="text"
      placeholder="Type something..."
      bind:value={inputText}
    />
    {#if inputText}
      <p class="echo">You typed: <strong>{inputText}</strong></p>
    {/if}
  </div>
</div>

