{
  "name": "C# ASP.NET Core Layered (Controller-Service-Repository)",
  "prerequisites": ["dotnet"],
  "shared": null,
  "stackFeatures": "aspnet",
  "modules": {
    "enabled": true,
    "message": "Module/entity name (e.g. product, user, order)",
    "default": "product"
  },
  "fileConditions": {
    "docker-compose.yml.hbs": "useDocker",
    "Dockerfile.hbs": "useAppDockerfile",
    ".dockerignore.hbs": "useAppDockerfile",
    ".github": "useCI",
    "AGENT.md.hbs": "useAgentDocs",
    "Data/AppDbContext.cs.hbs": "ormEfcore"
  },
  "postInstall": [
    "dotnet new sln",
    "dotnet sln add src/{{projectName}}/{{pascalCase projectName}}/{{pascalCase projectName}}.csproj",
    "dotnet restore"
  ],
  "gitInit": true
}
