# ---- app ----
APP_ENV=development
PORT=8080

{{#if hasDatabase}}
# ---- database ----
{{#if dbSqlite}}
DB_FILE=./data/{{snakeCase projectName}}.sqlite
{{else}}
{{#if dbPostgres}}
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{snakeCase projectName}}
{{/if}}
{{#if dbMysql}}
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME={{snakeCase projectName}}
{{/if}}
{{/if}}
{{/if}}
{{#if useRedis}}

# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
{{/if}}
{{#if useKafka}}

# ---- kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID={{projectName}}-consumer
{{/if}}
{{#if useRabbitmq}}

# ---- rabbitmq ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE={{projectName}}-queue
{{/if}}
{{#if useAuth}}

# ---- auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
{{/if}}
{{#if useRateLimit}}

# ---- rate limiting ----
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
{{/if}}
