package health

import (
	"net/http"

	"github.com/labstack/echo/v4"
{{#if healthChecksDb}}
	"gorm.io/gorm"
{{/if}}
)

type Handler struct {
{{#if healthChecksDb}}
	db *gorm.DB
{{/if}}
}

{{#if healthChecksDb}}
func NewHandler(db *gorm.DB) *Handler {
	return &Handler{db: db}
}
{{else}}
func NewHandler(_ *struct{}) *Handler {
	return &Handler{}
}
{{/if}}

func (h *Handler) Check(c echo.Context) error {
	healthy := true
	checks := make(map[string]string)

{{#if healthChecksDb}}
	sqlDB, err := h.db.DB()
	if err != nil {
		healthy = false
		checks["database"] = "error: " + err.Error()
	} else if err := sqlDB.Ping(); err != nil {
		healthy = false
		checks["database"] = "error: " + err.Error()
	} else {
		checks["database"] = "ok"
	}
{{/if}}

{{#if healthChecksRedis}}
	checks["redis"] = "ok"
{{/if}}

	status := http.StatusOK
	if !healthy {
		status = http.StatusServiceUnavailable
	}
	return c.JSON(status, map[string]interface{}{"status": healthy, "checks": checks})
}
