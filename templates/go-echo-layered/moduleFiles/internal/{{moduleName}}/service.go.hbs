package {{snakeCase moduleName}}

{{#if ormNone}}
import "github.com/google/uuid"
{{/if}}

type Service struct {
	repo Repository
}

func NewService(repo Repository) *Service {
	return &Service{repo: repo}
}

func (s *Service) Create(input Create{{pascalCase moduleName}}Request) (*{{pascalCase moduleName}}, error) {
	model := &{{pascalCase moduleName}}{
{{#if ormGorm}}
		Name: input.Name,
{{else}}
		ID:   uuid.New().String(),
		Name: input.Name,
{{/if}}
	}
	if err := s.repo.Save(model); err != nil {
		return nil, err
	}
	return model, nil
}

func (s *Service) List() ([]{{pascalCase moduleName}}, error) {
	return s.repo.FindAll()
}

func (s *Service) GetByID(id {{#if ormGorm}}uint{{else}}string{{/if}}) (*{{pascalCase moduleName}}, error) {
	return s.repo.FindByID(id)
}

func (s *Service) Delete(id {{#if ormGorm}}uint{{else}}string{{/if}}) error {
	return s.repo.Delete(id)
}
