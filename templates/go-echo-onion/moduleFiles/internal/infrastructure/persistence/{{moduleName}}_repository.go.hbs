{{else}}
type {{pascalCase moduleName}}Repo struct {
	mu    sync.RWMutex
	items map[string]*dom.{{pascalCase moduleName}}
}

func New{{pascalCase moduleName}}Repository() dom.{{pascalCase moduleName}}Repository {
	return &{{pascalCase moduleName}}Repo{items: make(map[string]*dom.{{pascalCase moduleName}})}
}

func (r *{{pascalCase moduleName}}Repo) Save(model *dom.{{pascalCase moduleName}}) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	r.items[model.ID] = model
	return nil
}

func (r *{{pascalCase moduleName}}Repo) FindAll() ([]dom.{{pascalCase moduleName}}, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	result := make([]dom.{{pascalCase moduleName}}, 0, len(r.items))
	for _, m := range r.items {
		result = append(result, *m)
	}
	return result, nil
}

func (r *{{pascalCase moduleName}}Repo) FindByID(id string) (*dom.{{pascalCase moduleName}}, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()
	if m, ok := r.items[id]; ok {
		return m, nil
	}
	return nil, nil
}

func (r *{{pascalCase moduleName}}Repo) Delete(id string) error {
	r.mu.Lock()
	defer r.mu.Unlock()
	delete(r.items, id)
	return nil
}
{{/if}}
