// @Success      201   {object}  {{pascalCase moduleName}}Response
// @Router       /{{moduleName}} [post]
{{/if}}
func (h *{{pascalCase moduleName}}Handler) Create(c fiber.Ctx) error {
	var req create{{pascalCase moduleName}}Request
	if err := c.BodyParser(&req); err != nil {
		return errors.BadRequest(c, "invalid body")
	}
{{#if useValidator}}
	validate := validator.New()
	if err := validate.Struct(req); err != nil {
		return errors.BadRequest(c, err.Error())
	}
{{/if}}

	model, err := h.uc.Create(req.Name)
	if err != nil {
		return errors.ErrorResponse(c, err)
	}
	return c.Status(fiber.StatusCreated).JSON(toResponse(model))
}

