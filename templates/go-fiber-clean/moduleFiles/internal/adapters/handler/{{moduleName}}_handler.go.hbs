func toResponse(m *entity.{{pascalCase moduleName}}) {{pascalCase moduleName}}Response {
	return {{pascalCase moduleName}}Response{
		ID:   m.ID,
		Name: m.Name,
{{#if ormGorm}}
		CreatedAt: m.CreatedAt.Format("2006-01-02T15:04:05Z07:00"),
		UpdatedAt: m.UpdatedAt.Format("2006-01-02T15:04:05Z07:00"),
{{/if}}
	}
}

func toResponseList(models []entity.{{pascalCase moduleName}}) []{{pascalCase moduleName}}Response {
	result := make([]{{pascalCase moduleName}}Response, len(models))
	for i, m := range models {
		result[i] = toResponse(&m)
	}
	return result
}

