package handler

import (
{{#if ormGorm}}
	"strconv"

	"gorm.io/gorm"
{{/if}}

	"github.com/gofiber/fiber/v3"
	app "{{github}}/{{projectName}}/internal/application/{{moduleName}}"
	dom "{{github}}/{{projectName}}/internal/domain/{{moduleName}}"
	"{{github}}/{{projectName}}/internal/errors"
)

type {{pascalCase moduleName}}Handler struct {
	uc *app.{{pascalCase moduleName}}UseCase
}

func New{{pascalCase moduleName}}Handler(repo dom.{{pascalCase moduleName}}Repository) *{{pascalCase moduleName}}Handler {
	svc := dom.New{{pascalCase moduleName}}Service(repo)
	uc := app.New{{pascalCase moduleName}}UseCase(svc)
	return &{{pascalCase moduleName}}Handler{uc: uc}
}

func toResponse(m *dom.{{pascalCase moduleName}}) app.{{pascalCase moduleName}}Response {
	return app.{{pascalCase moduleName}}Response{
		ID:   m.ID,
		Name: m.Name,
{{#if ormGorm}}
		CreatedAt: m.CreatedAt.Format("2006-01-02T15:04:05Z07:00"),
		UpdatedAt: m.UpdatedAt.Format("2006-01-02T15:04:05Z07:00"),
{{/if}}
	}
}

func toResponseList(models []dom.{{pascalCase moduleName}}) []app.{{pascalCase moduleName}}Response {
	result := make([]app.{{pascalCase moduleName}}Response, len(models))
	for i, m := range models {
		result[i] = toResponse(&m)
	}
	return result
}

{{#if useSwagger}}
// @Summary      List {{pascalCase moduleName}}
// @Description  Get all {{moduleName}} records
// @Tags         {{moduleName}}
// @Produce      json
// @Success      200  {array}  {{pascalCase moduleName}}Response
// @Router       /{{moduleName}} [get]
{{/if}}
func (h *{{pascalCase moduleName}}Handler) List(c fiber.Ctx) error {
	models, err := h.uc.List()
	if err != nil {
		return errors.ErrorResponse(c, err)
	}
	return c.Status(fiber.StatusOK).JSON(toResponseList(models))
}

{{#if useSwagger}}
// @Summary      Get {{pascalCase moduleName}}
// @Description  Get a {{moduleName}} by ID
// @Tags         {{moduleName}}
// @Produce      json
// @Param        id  path  int  true  "{{pascalCase moduleName}} ID"
// @Success      200  {object}  {{pascalCase moduleName}}Response
// @Router       /{{moduleName}}/{id} [get]
{{/if}}
func (h *{{pascalCase moduleName}}Handler) GetByID(c fiber.Ctx) error {
{{#if ormGorm}}
	id, err := strconv.ParseUint(c.Params("id"), 10, 64)
	if err != nil {
		return errors.BadRequest(c, "invalid id")
	}
	model, err := h.uc.GetByID(uint(id))
{{else}}
	id := c.Params("id")
	model, err := h.uc.GetByID(id)
{{/if}}
	if err != nil {
{{#if ormGorm}}
		if err == gorm.ErrRecordNotFound {
			return errors.NotFound(c, "{{moduleName}} not found")
		}
{{else}}
		if model == nil {
			return errors.NotFound(c, "{{moduleName}} not found")
		}
{{/if}}
		return errors.ErrorResponse(c, err)
	}
	return c.Status(fiber.StatusOK).JSON(toResponse(model))
}

{{#if useSwagger}}
// @Summary      Create {{pascalCase moduleName}}
// @Description  Create a new {{moduleName}}
// @Tags         {{moduleName}}
// @Accept       json
// @Produce      json
// @Param        body  body  app.Create{{pascalCase moduleName}}Request  true  "{{pascalCase moduleName}} data"
// @Success      201   {object}  {{pascalCase moduleName}}Response
// @Router       /{{moduleName}} [post]
{{/if}}
func (h *{{pascalCase moduleName}}Handler) Create(c fiber.Ctx) error {
	var req app.Create{{pascalCase moduleName}}Request
	if err := c.BodyParser(&req); err != nil {
		return errors.BadRequest(c, "invalid body")
	}

	model, err := h.uc.Create(req.Name)
	if err != nil {
		return errors.ErrorResponse(c, err)
	}
	return c.Status(fiber.StatusCreated).JSON(toResponse(model))
}

{{#if useSwagger}}
// @Summary      Delete {{pascalCase moduleName}}
// @Description  Delete a {{moduleName}} by ID
// @Tags         {{moduleName}}
// @Param        id  path  int  true  "{{pascalCase moduleName}} ID"
// @Success      204
// @Router       /{{moduleName}}/{id} [delete]
{{/if}}
func (h *{{pascalCase moduleName}}Handler) Delete(c fiber.Ctx) error {
{{#if ormGorm}}
	id, err := strconv.ParseUint(c.Params("id"), 10, 64)
	if err != nil {
		return errors.BadRequest(c, "invalid id")
	}
	err = h.uc.Delete(uint(id))
{{else}}
	id := c.Params("id")
	err := h.uc.Delete(id)
{{/if}}
	if err != nil {
		return errors.ErrorResponse(c, err)
	}
	return c.SendStatus(fiber.StatusNoContent)
}
