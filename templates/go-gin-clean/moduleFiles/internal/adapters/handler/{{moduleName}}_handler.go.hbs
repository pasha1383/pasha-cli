func (h *{{pascalCase moduleName}}Handler) GetByID(c *gin.Context) {
{{#if ormGorm}}
	id, err := strconv.ParseUint(c.Param("id"), 10, 64)
	if err != nil {
		errors.BadRequest(c, "invalid id")
		return
	}
	model, err := h.uc.GetByID(uint(id))
{{else}}
	id := c.Param("id")
	model, err := h.uc.GetByID(id)
{{/if}}
	if err != nil {
{{#if ormGorm}}
		if err == gorm.ErrRecordNotFound {
			errors.NotFound(c, "{{moduleName}} not found")
			return
		}
{{else}}
		if model == nil {
			errors.NotFound(c, "{{moduleName}} not found")
			return
		}
{{/if}}
		errors.ErrorResponse(c, err)
		return
	}
	c.JSON(http.StatusOK, toResponse(model))
}

