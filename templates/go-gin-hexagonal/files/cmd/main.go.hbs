package main

import (
	"log"

	"github.com/gin-gonic/gin"
	"{{github}}/{{projectName}}/internal/config"
	"{{github}}/{{projectName}}/internal/errors"
{{#if ormGorm}}
	"{{github}}/{{projectName}}/internal/shared/database"
{{/if}}
{{#if useRedis}}
	"{{github}}/{{projectName}}/internal/shared/cache"
{{/if}}
{{#if useAuth}}
	"{{github}}/{{projectName}}/internal/middleware"
{{/if}}
{{#if useRateLimit}}
	"{{github}}/{{projectName}}/internal/middleware"
{{/if}}
{{#if useHealthCheck}}
	"{{github}}/{{projectName}}/internal/shared/health"
{{/if}}
{{#if useSwagger}}
	_ "{{github}}/{{projectName}}/internal/docs"
	swaggerFiles "github.com/swaggo/files"
	ginSwagger "github.com/swaggo/gin-swagger"
{{/if}}
	infhdl "{{github}}/{{projectName}}/internal/infrastructure/handler"
	infprs "{{github}}/{{projectName}}/internal/infrastructure/persistence"
	appuc "{{github}}/{{projectName}}/internal/application"
)

func main() {
	cfg := config.Load()

	router := gin.Default()

{{#if ormGorm}}
	db, err := database.Connect(cfg)
	if err != nil {
		log.Fatalf("failed to connect to database: %v", err)
	}
{{/if}}

{{#if useRedis}}
	redisClient, err := cache.NewRedisClient(cfg)
	if err != nil {
		log.Fatalf("failed to connect to redis: %v", err)
	}
	_ = redisClient
{{/if}}

{{#if useAuth}}
	authMiddleware := middleware.NewAuthMiddleware(cfg.JWTSecret)
{{/if}}

{{#if useRateLimit}}
	rateLimitMiddleware := middleware.NewRateLimiter(cfg.RateLimitRPS, cfg.RateLimitBurst)
	router.Use(rateLimitMiddleware)
{{/if}}

{{#if useHealthCheck}}
{{#if ormGorm}}
	healthHandler := health.NewHandler(db)
{{else}}
	healthHandler := health.NewHandler(nil)
{{/if}}
	router.GET("/health", healthHandler.Check)
{{/if}}

{{#if useSwagger}}
	router.GET("/swagger/*any", ginSwagger.WrapHandler(swaggerFiles.Handler))
{{/if}}

	api := router.Group("/api")
{{#if useAuth}}
	api.Use(authMiddleware)
{{/if}}

{{#each modules}}
	{
{{#if ../ormGorm}}
		repo := infprs.New{{pascalCase this}}Repository(db)
		uc := appuc.New{{pascalCase this}}UseCase(repo)
		h := infhdl.New{{pascalCase this}}Handler(uc)
{{else}}
		repo := infprs.New{{pascalCase this}}Repository()
		uc := appuc.New{{pascalCase this}}UseCase(repo)
		h := infhdl.New{{pascalCase this}}Handler(uc)
{{/if}}
		r := api.Group("/{{this}}")
		r.GET("/{{this}}", h.List)
		r.GET("/{{this}}/:id", h.GetByID)
		r.POST("/{{this}}", h.Create)
		r.DELETE("/{{this}}/:id", h.Delete)
	}
{{/each}}

	router.NoRoute(func(c *gin.Context) {
		errors.NotFound(c, "route not found")
	})

	addr := ":" + cfg.Port
	log.Printf("server starting on %s", addr)
	if err := router.Run(addr); err != nil {
		log.Fatalf("server failed: %v", err)
	}
}
