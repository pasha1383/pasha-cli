name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-go@v5
        with:
          go-version: '1.22'
          cache: true

      - name: Build
        run: go build ./...

{{#if useLint}}
      - name: Lint
        uses: golangci/golangci-lint-action@v6
        with:
          version: latest
{{/if}}

{{#if useTests}}
      - name: Test
        run: go test ./... -v -coverprofile=coverage.out
{{/if}}
