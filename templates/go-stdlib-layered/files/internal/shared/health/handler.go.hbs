package health

import (
	"encoding/json"
	"net/http"
{{#if healthChecksDb}}
	"gorm.io/gorm"
{{/if}}
)

type Handler struct {
{{#if healthChecksDb}}
	db *gorm.DB
{{/if}}
}

{{#if healthChecksDb}}
func NewHandler(db *gorm.DB) *Handler {
	return &Handler{db: db}
}
{{else}}
func NewHandler(_ *struct{}) *Handler {
	return &Handler{}
}
{{/if}}

func (h *Handler) Check(w http.ResponseWriter, r *http.Request) {
	healthy := true
	checks := make(map[string]string)

{{#if healthChecksDb}}
	sqlDB, err := h.db.DB()
	if err != nil {
		healthy = false
		checks["database"] = "error: " + err.Error()
	} else if err := sqlDB.Ping(); err != nil {
		healthy = false
		checks["database"] = "error: " + err.Error()
	} else {
		checks["database"] = "ok"
	}
{{/if}}

{{#if healthChecksRedis}}
	checks["redis"] = "ok"
{{/if}}

	status := http.StatusOK
	if !healthy {
		status = http.StatusServiceUnavailable
	}
	w.Header().Set("Content-Type", "application/json")
	w.WriteHeader(status)
	json.NewEncoder(w).Encode(map[string]interface{}{
		"status": healthy,
		"checks": checks,
	})
}
