<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{description}}">
  <title>{{projectName}} — Dashboard</title>
  <link rel="stylesheet" href="styles/main.css">
  <link rel="icon" type="image/svg+xml" href="/vite.svg">
</head>
<body class="dashboard-layout">

  <a href="#main-content" class="skip-link">Skip to main content</a>

  <aside id="sidebar" class="sidebar" role="navigation" aria-label="Dashboard sidebar">
    <div class="sidebar-header">
      <a href="/" class="sidebar-brand" aria-label="{{projectName}} dashboard home">
        <span class="brand-icon" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
        </span>
        <span class="brand-text">{{projectName}}</span>
      </a>
      <button class="sidebar-close" aria-label="Close sidebar" id="sidebar-close-btn">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>
    </div>
    <nav aria-label="Dashboard navigation">
      <ul class="sidebar-nav">
        <li><a href="#dashboard" class="nav-item active" aria-current="page">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>
          Dashboard
        </a></li>
        <li><a href="#analytics" class="nav-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          Analytics
        </a></li>
        <li><a href="#users" class="nav-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          Users
        </a></li>
        <li><a href="#orders" class="nav-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Orders
        </a></li>
        <li><a href="#products" class="nav-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/></svg>
          Products
        </a></li>
        <li><a href="#settings" class="nav-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
          Settings
        </a></li>
      </ul>
    </nav>
  </aside>

  <div class="dashboard-main">
    <header class="topbar" role="banner">
      <button class="topbar-menu-btn" aria-label="Open sidebar" id="sidebar-open-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <div class="topbar-search">
        <label for="topbar-search-input" class="sr-only">Search</label>
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="topbar-search-input" class="topbar-search-input" placeholder="Search...">
      </div>
      <div class="topbar-actions">
        <button class="topbar-icon-btn" aria-label="Notifications">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
          <span class="badge">3</span>
        </button>
        <button class="topbar-avatar" aria-label="User menu" id="user-avatar-btn">
          <span class="avatar" aria-hidden="true" id="user-avatar"></span>
        </button>
      </div>
    </header>

    <main id="main-content" class="dashboard-content">

      <section class="page-header">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle">Welcome back, {{author}}. Here's what's happening today.</p>
      </section>

      <section class="stats-grid" aria-label="Key metrics">
        <article class="stat-card">
          <div class="stat-icon stat-icon-blue" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20V10M18 20V4M6 20v-4"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-value">$24,500</span>
            <span class="stat-label">Total Revenue</span>
            <span class="stat-change stat-change-up" aria-label="Increased by 12.5%">+12.5%</span>
          </div>
        </article>
        <article class="stat-card">
          <div class="stat-icon stat-icon-green" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-value">1,429</span>
            <span class="stat-label">Active Users</span>
            <span class="stat-change stat-change-up" aria-label="Increased by 8.2%">+8.2%</span>
          </div>
        </article>
        <article class="stat-card">
          <div class="stat-icon stat-icon-purple" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-value">892</span>
            <span class="stat-label">New Orders</span>
            <span class="stat-change stat-change-down" aria-label="Decreased by 3.1%">-3.1%</span>
          </div>
        </article>
        <article class="stat-card">
          <div class="stat-icon stat-icon-orange" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
          </div>
          <div class="stat-info">
            <span class="stat-value">$27.50</span>
            <span class="stat-label">Avg. Order Value</span>
            <span class="stat-change stat-change-up" aria-label="Increased by 2.4%">+2.4%</span>
          </div>
        </article>
      </section>

      <section class="charts-grid" aria-label="Charts">
        <article class="chart-card" aria-label="Revenue chart">
          <div class="chart-header">
            <h2 class="chart-title">Revenue Over Time</h2>
            <select class="chart-select" aria-label="Time period">
              <option>Last 7 days</option>
              <option>Last 30 days</option>
              <option>Last 90 days</option>
            </select>
          </div>
          <div class="chart-body">
            <div class="bar-chart" role="img" aria-label="Bar chart showing daily revenue">
              <div class="bar-group"><span class="bar-label">Mon</span><div class="bar" style="height:65%"><span class="bar-tooltip">$3,400</span></div></div>
              <div class="bar-group"><span class="bar-label">Tue</span><div class="bar" style="height:80%"><span class="bar-tooltip">$4,200</span></div></div>
              <div class="bar-group"><span class="bar-label">Wed</span><div class="bar" style="height:45%"><span class="bar-tooltip">$2,350</span></div></div>
              <div class="bar-group"><span class="bar-label">Thu</span><div class="bar" style="height:90%"><span class="bar-tooltip">$4,800</span></div></div>
              <div class="bar-group"><span class="bar-label">Fri</span><div class="bar" style="height:70%"><span class="bar-tooltip">$3,700</span></div></div>
              <div class="bar-group"><span class="bar-label">Sat</span><div class="bar" style="height:55%"><span class="bar-tooltip">$2,900</span></div></div>
              <div class="bar-group"><span class="bar-label">Sun</span><div class="bar" style="height:40%"><span class="bar-tooltip">$2,100</span></div></div>
            </div>
          </div>
        </article>

        <article class="chart-card" aria-label="Traffic sources">
          <div class="chart-header">
            <h2 class="chart-title">Traffic Sources</h2>
            <select class="chart-select" aria-label="Time period">
              <option>This week</option>
              <option>This month</option>
            </select>
          </div>
          <div class="chart-body">
            <div class="donut-chart" role="img" aria-label="Donut chart: 35% Direct, 30% Organic, 20% Referral, 15% Social">
              <svg viewBox="0 0 100 100" class="donut-svg">
                <circle cx="50" cy="50" r="35" fill="none" stroke="#e2e8f0" stroke-width="15"/>
                <circle cx="50" cy="50" r="35" fill="none" stroke="#6366f1" stroke-width="15" stroke-dasharray="76.97 143" stroke-dashoffset="0" transform="rotate(-90 50 50)"/>
                <circle cx="50" cy="50" r="35" fill="none" stroke="#10b981" stroke-width="15" stroke-dasharray="65.97 143" stroke-dashoffset="-76.97" transform="rotate(-90 50 50)"/>
                <circle cx="50" cy="50" r="35" fill="none" stroke="#f59e0b" stroke-width="15" stroke-dasharray="43.98 143" stroke-dashoffset="-142.94" transform="rotate(-90 50 50)"/>
                <circle cx="50" cy="50" r="35" fill="none" stroke="#ef4444" stroke-width="15" stroke-dasharray="32.99 143" stroke-dashoffset="-186.92" transform="rotate(-90 50 50)"/>
              </svg>
            </div>
            <div class="donut-legend">
              <div class="legend-item"><span class="legend-dot" style="background:#6366f1"></span> Direct <span class="legend-pct">35%</span></div>
              <div class="legend-item"><span class="legend-dot" style="background:#10b981"></span> Organic <span class="legend-pct">30%</span></div>
              <div class="legend-item"><span class="legend-dot" style="background:#f59e0b"></span> Referral <span class="legend-pct">20%</span></div>
              <div class="legend-item"><span class="legend-dot" style="background:#ef4444"></span> Social <span class="legend-pct">15%</span></div>
            </div>
          </div>
        </article>
      </section>

      <section class="table-section" aria-labelledby="recent-orders-heading">
        <div class="table-header">
          <h2 id="recent-orders-heading" class="table-title">Recent Orders</h2>
          <a href="#orders" class="table-action">View All <span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="table-wrapper" role="region" aria-label="Recent orders table" tabindex="0">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Order ID</th>
                <th scope="col">Customer</th>
                <th scope="col">Product</th>
                <th scope="col">Amount</th>
                <th scope="col">Status</th>
                <th scope="col">Date</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="td-mono">#ORD-7841</td>
                <td>Alice Johnson</td>
                <td>Pro Plan</td>
                <td>$299.00</td>
                <td><span class="status status-success">Completed</span></td>
                <td>2026-08-10</td>
              </tr>
              <tr>
                <td class="td-mono">#ORD-7840</td>
                <td>Bob Williams</td>
                <td>Starter Plan</td>
                <td>$49.00</td>
                <td><span class="status status-success">Completed</span></td>
                <td>2026-08-10</td>
              </tr>
              <tr>
                <td class="td-mono">#ORD-7839</td>
                <td>Carol Davis</td>
                <td>Enterprise Plan</td>
                <td>$999.00</td>
                <td><span class="status status-pending">Pending</span></td>
                <td>2026-08-09</td>
              </tr>
              <tr>
                <td class="td-mono">#ORD-7838</td>
                <td>Dan Martinez</td>
                <td>Pro Plan</td>
                <td>$299.00</td>
                <td><span class="status status-cancelled">Cancelled</span></td>
                <td>2026-08-09</td>
              </tr>
              <tr>
                <td class="td-mono">#ORD-7837</td>
                <td>Eve Thompson</td>
                <td>API Add-on</td>
                <td>$149.00</td>
                <td><span class="status status-success">Completed</span></td>
                <td>2026-08-08</td>
              </tr>
              <tr>
                <td class="td-mono">#ORD-7836</td>
                <td>Frank Garcia</td>
                <td>Analytics Add-on</td>
                <td>$79.00</td>
                <td><span class="status status-pending">Pending</span></td>
                <td>2026-08-08</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    </main>

    <footer class="dashboard-footer" role="contentinfo">
      <p>&copy; <span id="current-year"></span> {{projectName}}. Built by {{author}}.</p>
    </footer>
  </div>

  <div class="sidebar-overlay" id="sidebar-overlay" aria-hidden="true"></div>

  <script id="app-data" type="application/json">{"author":"{{author}}"}</script>
  <script type="module" src="scripts/main.js"></script>
</body>
</html>
