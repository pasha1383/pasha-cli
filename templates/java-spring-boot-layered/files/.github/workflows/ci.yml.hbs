name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'
          cache: 'maven'

      {{#if useCheckstyle}}
      - name: Checkstyle
        run: mvn checkstyle:check
      {{/if}}

      - name: Build
        run: mvn -B package -DskipTests

      {{#if useTests}}
      - name: Test
        run: mvn test
      {{/if}}
