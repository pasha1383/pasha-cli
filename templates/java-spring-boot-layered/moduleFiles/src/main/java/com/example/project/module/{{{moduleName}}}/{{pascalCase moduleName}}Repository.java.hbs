import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicLong;

@Repository
public class {{pascalCase moduleName}}Repository {

    private final Map<Long, {{pascalCase moduleName}}> store = new ConcurrentHashMap<>();
    private final AtomicLong nextId = new AtomicLong(1);

    public {{pascalCase moduleName}} save({{pascalCase moduleName}} entity) {
        if (entity.getId() == null || entity.getId() == 0) {
            entity.setId(nextId.getAndIncrement());
        }
        store.put(entity.getId(), entity);
        return entity;
    }

    public List<{{pascalCase moduleName}}> findAll() {
        return new ArrayList<>(store.values());
    }

    public Optional<{{pascalCase moduleName}}> findById(Long id) {
        return Optional.ofNullable(store.get(id));
    }

    public void deleteById(Long id) {
        store.remove(id);
    }
