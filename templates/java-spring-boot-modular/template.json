{
  "name": "Java + Spring Boot + Modular Monolith",
  "prerequisites": ["java", "mvn", "git"],
  "shared": "_shared/java-spring-boot",
  "stackFeatures": "spring-boot",
  "modules": {
    "enabled": true,
    "message": "Module name (e.g. product, user, order)",
    "default": "product"
  },
  "fileConditions": {
    "docker-compose.yml.hbs": "useDocker",
    "src/main/java/com/example/project/shared": "hasSharedInfra",
    "src/main/java/com/example/project/shared/database": "hasOrm",
    "src/main/java/com/example/project/shared/database/JpaConfig.java.hbs": "ormJpa",
    "src/main/java/com/example/project/shared/database/MyBatisConfig.java.hbs": "ormMybatis",
    "src/main/java/com/example/project/shared/database/NoneConfig.java.hbs": "ormNone",
    "src/main/java/com/example/project/shared/cache": "useRedis",
    "src/main/java/com/example/project/shared/auth": "useAuth",
    "src/main/java/com/example/project/shared/health": "useHealthCheck",
    "src/main/java/com/example/project/shared/kafka": "useKafka",
    "src/main/java/com/example/project/shared/rabbitmq": "useRabbitmq",
    "AGENT.md.hbs": "useAgentDocs",
    "src/test/java/com/example/project/module/{{moduleName}}/internal": "useTests",
    "checkstyle.xml.hbs": "useCheckstyle",
    "Dockerfile.hbs": "useAppDockerfile",
    ".dockerignore.hbs": "useAppDockerfile",
    ".github": "useCI"
  },
  "postInstall": [],
  "gitInit": true
}
