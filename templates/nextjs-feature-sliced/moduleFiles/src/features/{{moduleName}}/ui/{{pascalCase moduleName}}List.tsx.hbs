'use client';

import type { {{pascalCase moduleName}} } from '../model/types';

interface {{pascalCase moduleName}}ListProps {
  items: {{pascalCase moduleName}}[];
}

export function {{pascalCase moduleName}}List({ items }: {{pascalCase moduleName}}ListProps) {
  if (items.length === 0) {
    return <p className="text-center text-gray-500 py-8">No {{moduleName}} items found.</p>;
  }

  return (
    <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
