# ---- app ----
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
APP_KEY=change-me-to-a-random-string

{{#if hasDatabase}}
# ---- database ----
{{#if dbSqlite}}
DB_CONNECTION=sqlite
DB_DATABASE=./data/{{snakeCase projectName}}.sqlite
{{/if}}
{{#if dbPostgres}}
DB_CONNECTION=pg
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE={{snakeCase projectName}}
{{/if}}
{{#if dbMysql}}
DB_CONNECTION=mysql2
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_DATABASE={{snakeCase projectName}}
{{/if}}
{{/if}}
{{#if useRedis}}

# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
{{/if}}
{{#if useAuth}}

# ---- auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
{{/if}}
{{#if useRateLimit}}

# ---- rate limiting ----
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
{{/if}}
