{
  "name": "Node.js + AdonisJS + MVC (Adonis Native)",
  "prerequisites": ["node", "npm", "git"],
  "shared": null,
  "stackFeatures": "adonis",
  "modules": {
    "enabled": true,
    "message": "Module/entity name (e.g. product, user, order)",
    "default": "product"
  },
  "fileConditions": {
    "docker-compose.yml.hbs": "useDocker",
    "src/shared": "hasSharedInfra",
    "src/shared/database": "hasOrm",
    "src/shared/database/lucid.ts.hbs": "ormLucid",
    "src/shared/cache": "useRedis",
    "AGENT.md.hbs": "useAgentDocs",
    "src/app/middleware/auth.middleware.ts.hbs": "useAuth",
    "src/shared/health/health.routes.ts.hbs": "useHealthCheck",
    "src/shared/auth": "useAuth",
    ".eslintrc.js": "useLint",
    ".prettierrc": "useLint",
    ".github": "useCI",
    "Dockerfile.hbs": "useAppDockerfile",
    ".dockerignore.hbs": "useAppDockerfile"
  },
  "postInstall": ["npm install"],
  "gitInit": true
}
