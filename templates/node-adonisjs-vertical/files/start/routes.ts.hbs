import router from '@adonisjs/core/services/router';
{{#if useHealthCheck}}
import { healthRouter } from '../src/shared/health/health.routes';
{{/if}}
{{#each modules}}
const {{camelCase this}}RoutesModule = await import('../app/features/{{this}}/{{this}}.routes');
const register{{pascalCase this}}Routes = {{camelCase this}}RoutesModule.register{{pascalCase this}}Routes;
{{/each}}

router.get('/', async () => {
  return { app: '{{projectName}}', version: '0.1.0' };
});

{{#if useHealthCheck}}
router.group(() => {
  healthRouter();
}).prefix('/health');
{{/if}}

{{#each modules}}
router.group(() => {
  register{{pascalCase this}}Routes();
}).prefix('/{{this}}');
{{/each}}
