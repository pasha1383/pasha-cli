import { Schema, model } from 'mongoose';

/**
 * Persistence model. Separate from the core entity so schema changes never
 * reach into core/.
 */
export const {{camelCase moduleName}}Schema = new Schema(
  {
    id: { type: String, required: true, unique: true },
    name: { type: String, required: true },
  },
  { timestamps: true, collection: '{{snakeCase moduleName}}' },
);

export const {{pascalCase moduleName}}Model = model('{{pascalCase moduleName}}', {{camelCase moduleName}}Schema);
