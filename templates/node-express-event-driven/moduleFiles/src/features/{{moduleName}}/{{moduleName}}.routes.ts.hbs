import { {{pascalCase moduleName}}Projection } from './projections/{{moduleName}}.projection';
import { EventStore } from './event-store/event-store';
import { Outbox } from './infrastructure/outbox/outbox';

const {{camelCase moduleName}}Router = Router();

// ---- DI: wire up shared infrastructure ----
const eventStore = new EventStore();
