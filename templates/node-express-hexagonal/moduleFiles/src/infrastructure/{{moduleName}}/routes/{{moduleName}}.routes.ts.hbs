import { Router } from 'express';
{{#if useExpressValidator}}
import { create{{pascalCase moduleName}}Validation } from '../../../application/{{moduleName}}/dto/create-{{moduleName}}.dto';
import { handleValidationErrors } from '../../../middlewares/handle-validation-errors.middleware';
{{/if}}
{{#if useZod}}
import { create{{pascalCase moduleName}}Schema } from '../../../application/{{moduleName}}/dto/create-{{moduleName}}.dto';
import { validateBody } from '../../../middlewares/validate-body.middleware';
{{/if}}
import { {{pascalCase moduleName}}Controller } from '../controllers/{{moduleName}}.controller';

/**
 * Route factory. Takes a pre-wired controller (constructed in app.ts) and
 * returns an Express Router. No wiring happens here — just binding HTTP
 * verbs to controller methods.
 */
export function {{camelCase moduleName}}Routes(controller: {{pascalCase moduleName}}Controller): Router {
  const router = Router();

{{#if useExpressValidator}}
  router.post('/', create{{pascalCase moduleName}}Validation, handleValidationErrors, controller.create);
{{else}}
{{#if useZod}}
  router.post('/', validateBody(create{{pascalCase moduleName}}Schema), controller.create);
{{else}}
  router.post('/', controller.create);
{{/if}}
{{/if}}
  router.get('/', controller.findAll);
  router.get('/:id', controller.findOne);

  return router;
}
