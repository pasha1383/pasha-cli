{
  "name": "Node.js + Express + Hexagonal/DDD",
  "prerequisites": ["node", "npm", "git"],
  "shared": null,
  "stackFeatures": "express",
  "modules": {
    "enabled": true,
    "message": "Module/entity name (e.g. product, user, order)",
    "default": "product"
  },
  "fileConditions": {
    "docker-compose.yml.hbs": "useDocker",
    "src/shared": "hasSharedInfra",
    "src/shared/database": "hasOrm",
    "src/shared/database/prisma.client.ts.hbs": "ormPrisma",
    "src/shared/database/typeorm.datasource.ts.hbs": "ormTypeorm",
    "src/shared/database/mongoose.connection.ts.hbs": "ormMongoose",
    "src/shared/cache": "useRedis",
    "AGENT.md.hbs": "useAgentDocs",
    "src/AGENT.md.hbs": "useAgentDocs",
    "src/domain/AGENT.md.hbs": "useAgentDocs",
    "src/application/AGENT.md.hbs": "useAgentDocs",
    "src/infrastructure/AGENT.md.hbs": "useAgentDocs",
    "src/middlewares/validate-body.middleware.ts.hbs": "useZod",
    "src/middlewares/handle-validation-errors.middleware.ts.hbs": "useExpressValidator",
    "src/application/{{moduleName}}/dto/create-{{moduleName}}.dto.ts.hbs": "hasValidation",
    "src/config/swagger.ts.hbs": "useSwagger",
    ".eslintrc.js": "useLint",
    ".prettierrc": "useLint",
    "jest.config.ts.hbs": "useTests",
    "jest.e2e.config.ts.hbs": "useTests",
    "test": "useTests",
    ".github": "useCI",
    "src/shared/auth": "useAuth",
    "src/shared/health": "useHealthCheck",
    "Dockerfile.hbs": "useAppDockerfile",
    ".dockerignore.hbs": "useAppDockerfile",
    "src/infrastructure/{{moduleName}}/persistence/{{moduleName}}.repository.ts.hbs": "ormNone",
    "src/infrastructure/{{moduleName}}/persistence/{{moduleName}}.prisma.repository.ts.hbs": "ormPrisma",
    "src/infrastructure/{{moduleName}}/persistence/{{moduleName}}.orm-entity.ts.hbs": "ormTypeorm",
    "src/infrastructure/{{moduleName}}/persistence/{{moduleName}}.typeorm.repository.ts.hbs": "ormTypeorm",
    "src/infrastructure/{{moduleName}}/persistence/{{moduleName}}.schema.ts.hbs": "ormMongoose",
    "src/infrastructure/{{moduleName}}/persistence/{{moduleName}}.mongoose.repository.ts.hbs": "ormMongoose",
    "src/application/{{moduleName}}/use-cases/create-{{moduleName}}.use-case.spec.ts.hbs": "useTests"
  },
  "postInstall": ["npm install"],
  "gitInit": true
}
