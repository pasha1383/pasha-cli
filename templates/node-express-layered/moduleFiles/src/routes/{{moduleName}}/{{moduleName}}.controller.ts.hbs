import { NextFunction, Request, Response } from 'express';
import { {{pascalCase moduleName}}Service } from './{{moduleName}}.service';

export class {{pascalCase moduleName}}Controller {
  constructor(private readonly service: {{pascalCase moduleName}}Service) {}

  create = async (req: Request, res: Response, next: NextFunction): Promise<void> => {
    try {
      const entity = await this.service.create(req.body);
      res.status(201).json(entity);
    } catch (err) {
      next(err);
    }
  };

  findAll = async (_req: Request, res: Response, next: NextFunction): Promise<void> => {
    try {
      const entities = await this.service.findAll();
      res.json(entities);
    } catch (err) {
      next(err);
    }
  };

  findOne = async (req: Request, res: Response, next: NextFunction): Promise<void> => {
    try {
      const entity = await this.service.findOne(req.params.id);
      res.json(entity);
    } catch (err) {
      next(err);
    }
  };
}
