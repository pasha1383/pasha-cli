import { NextFunction, Request, Response } from 'express';
import { validationResult } from 'express-validator';
import { ValidationError } from '../errors/app-error';

/**
 * Usage: router.post('/', createProductValidation, handleValidationErrors, handler)
 * Runs after the express-validator chains have populated req's validation
 * result; turns any failures into a single ValidationError for the shared
 * error handler to format.
 */
export function handleValidationErrors(req: Request, _res: Response, next: NextFunction): void {
  const errors = validationResult(req);
  if (!errors.isEmpty()) {
    next(new ValidationError(errors.array().map((e) => e.msg).join(', ')));
    return;
  }
  next();
}
