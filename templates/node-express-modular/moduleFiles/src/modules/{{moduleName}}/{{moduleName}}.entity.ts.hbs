{{#if ormTypeorm}}
import { Column, Entity, PrimaryColumn } from 'typeorm';

@Entity('{{snakeCase moduleName}}')
export class {{pascalCase moduleName}} {
  @PrimaryColumn('varchar')
  id!: string;

  @Column('varchar')
  name!: string;
}
{{/if}}
{{#if ormMongoose}}
import { Schema, model } from 'mongoose';

export class {{pascalCase moduleName}} {
  constructor(
    public readonly id: string,
    public name: string,
  ) {}
}

// Persistence model — kept separate from the domain class above so schema
// details (timestamps, Mongo's own _id) never leak into the domain shape.
const {{camelCase moduleName}}Schema = new Schema(
  {
    id: { type: String, required: true, unique: true },
    name: { type: String, required: true },
  },
  { timestamps: true, collection: '{{snakeCase moduleName}}' },
);

export const {{pascalCase moduleName}}Model = model('{{pascalCase moduleName}}', {{camelCase moduleName}}Schema);
{{/if}}
{{#unless ormTypeorm}}
{{#unless ormMongoose}}
export class {{pascalCase moduleName}} {
  constructor(
    public readonly id: string,
    public name: string,
  ) {}
}
{{/unless}}
{{/unless}}
