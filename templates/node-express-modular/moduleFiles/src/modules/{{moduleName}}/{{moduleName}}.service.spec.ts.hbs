import { {{pascalCase moduleName}}Repository } from './{{moduleName}}.repository';
import { {{pascalCase moduleName}}Service } from './{{moduleName}}.service';
import { {{pascalCase moduleName}} } from './{{moduleName}}.entity';

describe('{{pascalCase moduleName}}Service', () => {
  let repository: {{pascalCase moduleName}}Repository;
  let service: {{pascalCase moduleName}}Service;

  beforeEach(() => {
    repository = new {{pascalCase moduleName}}Repository();
    service = new {{pascalCase moduleName}}Service(repository);
  });

  describe('create', () => {
    it('creates a {{moduleName}} with a generated id', async () => {
      const result = await service.create({ name: 'test-{{moduleName}}' });

      expect(result).toBeInstanceOf({{pascalCase moduleName}});
      expect(result.id).toBeDefined();
      expect(result.name).toBe('test-{{moduleName}}');
    });
  });

  describe('findAll', () => {
    it('returns all {{moduleName}}s', async () => {
      await service.create({ name: 'a' });
      await service.create({ name: 'b' });

      const results = await service.findAll();
      expect(results.length).toBe(2);
