import express, { Express } from 'express';
import cors from 'cors';
import helmet from 'helmet';
import morgan from 'morgan';
import { errorHandler, notFoundHandler } from './middlewares/error-handler.middleware';
{{#if useRateLimit}}
import rateLimit from 'express-rate-limit';
import { env } from './config/env';
{{/if}}
{{#if useSwagger}}
import { setupSwagger } from './config/swagger';
{{/if}}
{{#if useAuth}}
import { authRouter } from './shared/auth/auth.middleware';
{{/if}}
{{#if useHealthCheck}}
import { healthRouter } from './shared/health/health.routes';
{{/if}}
{{#each modules}}
{{#if ../ormPrisma}}
import { {{pascalCase this}}PrismaRepository } from './infrastructure/persistence/{{this}}.prisma.repository';
{{/if}}
{{#if ../ormTypeorm}}
import { {{pascalCase this}}TypeormRepository } from './infrastructure/persistence/{{this}}.typeorm.repository';
{{/if}}
{{#if ../ormMongoose}}
import { {{pascalCase this}}MongooseRepository } from './infrastructure/persistence/{{this}}.mongoose.repository';
{{/if}}
{{#if ../ormNone}}
import { {{pascalCase this}}InMemoryRepository } from './infrastructure/persistence/{{this}}.repository';
{{/if}}
import { {{pascalCase this}}Service } from './application/services/{{this}}.service';
import { {{pascalCase this}}Controller } from './presentation/{{this}}/{{this}}.controller';
import { {{camelCase this}}Routes } from './presentation/{{this}}/{{this}}.routes';
{{/each}}

export function createApp(): Express {
  const app = express();

  app.use(helmet());
  app.use(cors());
  app.use(express.json());
  app.use(morgan('dev'));

{{#if useRateLimit}}
  app.use(
    rateLimit({
      windowMs: env.rateLimitWindowMs,
      max: env.rateLimitMax,
      standardHeaders: true,
      legacyHeaders: false,
    }),
  );
{{/if}}

{{#if useHealthCheck}}
  app.use(healthRouter);
{{/if}}

{{#if useAuth}}
  app.use(authRouter);
{{/if}}

{{#each modules}}
  {{#if ../ormPrisma}}
  const {{camelCase this}}Repo = new {{pascalCase this}}PrismaRepository();
  {{/if}}
  {{#if ../ormTypeorm}}
  const {{camelCase this}}Repo = new {{pascalCase this}}TypeormRepository();
  {{/if}}
  {{#if ../ormMongoose}}
  const {{camelCase this}}Repo = new {{pascalCase this}}MongooseRepository();
  {{/if}}
  {{#if ../ormNone}}
  const {{camelCase this}}Repo = new {{pascalCase this}}InMemoryRepository();
  {{/if}}
  const {{camelCase this}}Service = new {{pascalCase this}}Service({{camelCase this}}Repo);
  const {{camelCase this}}Controller = new {{pascalCase this}}Controller({{camelCase this}}Service);
  app.use('/{{this}}', {{camelCase this}}Routes({{camelCase this}}Controller));
{{/each}}

{{#if useSwagger}}
  setupSwagger(app);
{{/if}}

  app.use(notFoundHandler);
  app.use(errorHandler);

  return app;
}
