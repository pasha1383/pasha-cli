{{#if ormPrisma}}
import { prisma } from '../../../shared/database/prisma.client';
import { {{pascalCase moduleName}} } from '../../core/use-cases/{{moduleName}}/{{moduleName}}.entity';
import { {{pascalCase moduleName}}Repository } from '../../core/use-cases/{{moduleName}}/{{moduleName}}.repository.interface';

export class Prisma{{pascalCase moduleName}}Repository implements {{pascalCase moduleName}}Repository {
  async save(entity: {{pascalCase moduleName}}): Promise<void> {
    await prisma.{{camelCase moduleName}}.upsert({
      where: { id: entity.id },
      create: { id: entity.id, name: entity.name },
      update: { name: entity.name },
    });
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    const rows = await prisma.{{camelCase moduleName}}.findMany();
    return rows.map((r: { id: string; name: string }) => new {{pascalCase moduleName}}(r.id, r.name));
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    const row = await prisma.{{camelCase moduleName}}.findUnique({ where: { id } });
    return row ? new {{pascalCase moduleName}}(row.id, row.name) : null;
  }
}
