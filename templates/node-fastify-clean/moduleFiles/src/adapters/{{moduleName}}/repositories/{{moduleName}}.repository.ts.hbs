export class Typeorm{{pascalCase moduleName}}Repository implements {{pascalCase moduleName}}Repository {
  private readonly repo: Repository<{{pascalCase moduleName}}OrmEntity> = AppDataSource.getRepository({{pascalCase moduleName}}OrmEntity);

  async save(entity: {{pascalCase moduleName}}): Promise<void> {
    const ormEntity = this.repo.create({ id: entity.id, name: entity.name });
    await this.repo.save(ormEntity);
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    const rows = await this.repo.find();
    return rows.map((r) => new {{pascalCase moduleName}}(r.id, r.name));
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    const row = await this.repo.findOne({ where: { id } });
    return row ? new {{pascalCase moduleName}}(row.id, row.name) : null;
  }
}
