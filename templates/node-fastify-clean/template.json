{
  "name": "Node.js + Fastify + Clean Architecture",
  "prerequisites": ["node", "npm", "git"],
  "shared": null,
  "stackFeatures": "fastify",
  "modules": {
    "enabled": true,
    "message": "Module/entity name (e.g. product, user, order)",
    "default": "product"
  },
  "fileConditions": {
    "docker-compose.yml.hbs": "useDocker",
    "src/shared": "hasSharedInfra",
    "src/shared/database": "hasOrm",
    "src/shared/database/prisma.client.ts.hbs": "ormPrisma",
    "src/shared/database/typeorm.datasource.ts.hbs": "ormTypeorm",
    "src/shared/database/mongoose.connection.ts.hbs": "ormMongoose",
    "src/shared/cache": "useRedis",
    "AGENT.md.hbs": "useAgentDocs",
    "src/adapters/{{moduleName}}/repositories/{{moduleName}}.orm-entity.ts.hbs": "ormTypeorm",
    "src/adapters/{{moduleName}}/repositories/{{moduleName}}.schema.ts.hbs": "ormMongoose",
    ".eslintrc.js": "useLint",
    ".prettierrc": "useLint",
    "Dockerfile.hbs": "useAppDockerfile",
    ".dockerignore.hbs": "useAppDockerfile",
    ".github": "useCI",
    "test": "useTests",
    "src/config/swagger.ts.hbs": "useSwagger",
    "src/shared/auth": "useAuth",
    "src/shared/health": "useHealthCheck",
    "src/core/use-cases/{{moduleName}}/create-{{moduleName}}.use-case.spec.ts.hbs": "useTests"
  },
  "postInstall": ["npm install"],
  "gitInit": true
}
