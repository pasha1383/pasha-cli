import Fastify, { FastifyInstance } from 'fastify';
import cors from '@fastify/cors';
import helmet from '@fastify/helmet';
import { AppError } from './errors/app-error';
{{#if useSwagger}}
import { setupSwagger } from './config/swagger';
{{/if}}
{{#if useRateLimit}}
import { env } from './config/env';
{{/if}}
{{#if useAuth}}
import { authPlugin } from './shared/auth/auth.plugin';
{{/if}}
{{#if useHealthCheck}}
import { healthRoutes } from './shared/health/health.routes';
{{/if}}
{{#each modules}}
{{#if ../hasOrm}}
{{#if ../ormTypeorm}}import { {{pascalCase this}}TypeormRepository } from './infrastructure/{{this}}/persistence/{{this}}.typeorm.repository';{{/if}}
{{#if ../ormMongoose}}import { {{pascalCase this}}MongooseRepository } from './infrastructure/{{this}}/persistence/{{this}}.mongoose.repository';{{/if}}
{{#if ../ormPrisma}}import { {{pascalCase this}}PrismaRepository } from './infrastructure/{{this}}/persistence/{{this}}.prisma.repository';{{/if}}
{{#if ../ormNone}}import { {{pascalCase this}}InMemoryRepository } from './infrastructure/{{this}}/persistence/{{this}}.repository';{{/if}}
{{/if}}
{{#unless ../hasOrm}}
import { {{pascalCase this}}InMemoryRepository } from './infrastructure/{{this}}/persistence/{{this}}.repository';
{{/unless}}
import { Create{{pascalCase this}}UseCase } from './application/{{this}}/use-cases/create-{{this}}.use-case';
import { Get{{pascalCase this}}sUseCase } from './application/{{this}}/use-cases/get-{{this}}s.use-case';
import {{camelCase this}}Routes from './infrastructure/{{this}}/routes/{{this}}.routes';
{{/each}}

export async function buildApp(): Promise<FastifyInstance> {
  const fastify = Fastify({ logger: true });

  await fastify.register(cors);
  await fastify.register(helmet, { contentSecurityPolicy: false });

{{#if useRateLimit}}
  await fastify.register(import('@fastify/rate-limit'), {
    max: env.rateLimitMax,
    timeWindow: env.rateLimitWindowMs,
  });
{{/if}}

{{#if useSwagger}}
  await setupSwagger(fastify);
{{/if}}

{{#if useAuth}}
  await fastify.register(authPlugin);
{{/if}}

{{#if useHealthCheck}}
  await fastify.register(healthRoutes, { prefix: '/health' });
{{/if}}

{{#each modules}}
  await fastify.register({{camelCase this}}Routes, { prefix: '/{{this}}' });
{{/each}}

  fastify.setErrorHandler((error, _request, reply) => {
    if (error instanceof AppError) {
      reply.status(error.statusCode).send({ error: error.message });
      return;
    }
    fastify.log.error(error);
    reply.status(500).send({ error: 'Internal server error' });
  });

  fastify.setNotFoundHandler((_request, reply) => {
    reply.status(404).send({ error: 'Not found' });
  });

  return fastify;
}
