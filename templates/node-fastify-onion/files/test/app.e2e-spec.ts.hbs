import { buildApp } from '../src/app';
import type { FastifyInstance } from 'fastify';

describe('App (e2e)', () => {
  let app: FastifyInstance;

  beforeAll(async () => {
    app = await buildApp();
  });

  afterAll(async () => {
    await app.close();
  });

{{#if useHealthCheck}}
  it('/health (GET) reports the app is up', async () => {
    const res = await app.inject({ method: 'GET', url: '/health' });
    expect(res.statusCode).toBe(200);
    expect(JSON.parse(res.payload).status).toBe('ok');
  });
{{/if}}
{{#each modules}}
  it('/{{this}} (GET) returns a list', async () => {
    const res = await app.inject({ method: 'GET', url: '/{{this}}' });
    expect(res.statusCode).toBe(200);
    expect(Array.isArray(JSON.parse(res.payload))).toBe(true);
  });
{{/each}}
});
