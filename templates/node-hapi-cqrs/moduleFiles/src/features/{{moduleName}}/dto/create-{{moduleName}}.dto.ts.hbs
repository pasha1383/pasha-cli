{{#if useJoi}}
import Joi from 'joi';

export const create{{pascalCase moduleName}}Schema = Joi.object({
  name: Joi.string().min(1).max(255).required(),
});
{{/if}}
{{#if useZod}}
import { z } from 'zod';

export const create{{pascalCase moduleName}}Schema = z.object({
  name: z.string().min(1).max(255),
});
{{/if}}
