import { ServerRoute } from '@hapi/hapi';
{{#if useJoi}}
import { create{{pascalCase moduleName}}Schema } from './dto/create-{{moduleName}}.dto';
{{/if}}
{{#if useZod}}
import { create{{pascalCase moduleName}}Schema } from './dto/create-{{moduleName}}.dto';
{{/if}}
import { CommandBus, QueryBus } from './infrastructure/bus';
import { {{pascalCase moduleName}}Controller } from './infrastructure/{{moduleName}}.controller';
import { I{{pascalCase moduleName}}Repository } from './domain/{{moduleName}}.repository.interface';
{{#if ormNone}}
import { {{pascalCase moduleName}}InMemoryRepository } from './infrastructure/{{moduleName}}.repository';
{{/if}}
{{#if ormPrisma}}
import { {{pascalCase moduleName}}PrismaRepository } from './infrastructure/{{moduleName}}.prisma.repository';
{{/if}}
{{#if ormTypeorm}}
import { {{pascalCase moduleName}}TypeormRepository } from './infrastructure/{{moduleName}}.typeorm.repository';
{{/if}}
{{#if ormMongoose}}
import { {{pascalCase moduleName}}MongooseRepository } from './infrastructure/{{moduleName}}.mongoose.repository';
{{/if}}
import { Create{{pascalCase moduleName}}Command } from './commands/create-{{moduleName}}.command';
import { Create{{pascalCase moduleName}}Handler } from './commands/create-{{moduleName}}.handler';
import { Update{{pascalCase moduleName}}Command } from './commands/update-{{moduleName}}.command';
import { Update{{pascalCase moduleName}}Handler } from './commands/update-{{moduleName}}.handler';
import { Delete{{pascalCase moduleName}}Command } from './commands/delete-{{moduleName}}.handler';
import { Delete{{pascalCase moduleName}}Handler } from './commands/delete-{{moduleName}}.handler';
import { Get{{pascalCase moduleName}}Query } from './queries/get-{{moduleName}}.query';
import { Get{{pascalCase moduleName}}Handler } from './queries/get-{{moduleName}}.handler';
import { List{{pascalCase moduleName}}sQuery } from './queries/list-{{moduleName}}s.query';
import { List{{pascalCase moduleName}}sHandler } from './queries/list-{{moduleName}}s.handler';

// ---- DI: wire up repository ----
{{#if ormNone}}
const repository: I{{pascalCase moduleName}}Repository = new {{pascalCase moduleName}}InMemoryRepository();
{{/if}}
{{#if ormPrisma}}
const repository: I{{pascalCase moduleName}}Repository = new {{pascalCase moduleName}}PrismaRepository();
{{/if}}
{{#if ormTypeorm}}
const repository: I{{pascalCase moduleName}}Repository = new {{pascalCase moduleName}}TypeormRepository();
{{/if}}
{{#if ormMongoose}}
const repository: I{{pascalCase moduleName}}Repository = new {{pascalCase moduleName}}MongooseRepository();
{{/if}}

// ---- DI: wire up handlers ----
const createHandler = new Create{{pascalCase moduleName}}Handler(repository);
const updateHandler = new Update{{pascalCase moduleName}}Handler(repository);
const deleteHandler = new Delete{{pascalCase moduleName}}Handler(repository);
const getHandler = new Get{{pascalCase moduleName}}Handler(repository);
const listHandler = new List{{pascalCase moduleName}}sHandler(repository);

// ---- Bus registration ----
const commandBus = new CommandBus();
commandBus.register(Create{{pascalCase moduleName}}Command, createHandler);
commandBus.register(Update{{pascalCase moduleName}}Command, updateHandler);
commandBus.register(Delete{{pascalCase moduleName}}Command, deleteHandler);

const queryBus = new QueryBus();
queryBus.register(Get{{pascalCase moduleName}}Query, getHandler);
queryBus.register(List{{pascalCase moduleName}}sQuery, listHandler);

// ---- Controller ----
const controller = new {{pascalCase moduleName}}Controller(commandBus, queryBus);

// ---- Routes ----
export const {{camelCase moduleName}}Routes: ServerRoute[] = [
  {
    method: 'POST',
    path: '/{{moduleName}}',
    handler: controller.create,
{{#if useJoi}}
    options: {
      validate: {
        payload: create{{pascalCase moduleName}}Schema,
      },
    },
{{/if}}
  },
  { method: 'GET', path: '/{{moduleName}}', handler: controller.findAll },
  { method: 'GET', path: '/{{moduleName}}/{id}', handler: controller.findOne },
  { method: 'PATCH', path: '/{{moduleName}}/{id}', handler: controller.update },
  { method: 'DELETE', path: '/{{moduleName}}/{id}', handler: controller.remove },
];

// ---- Plugin ----
export const {{camelCase moduleName}}Plugin = {
  name: '{{moduleName}}',
  register: async (server: any) => {
    server.route({{camelCase moduleName}}Routes);
  },
};
