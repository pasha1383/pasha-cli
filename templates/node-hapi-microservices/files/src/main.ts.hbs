import { initGateway } from './server';
import { env } from './config/env';
{{#if ormTypeorm}}
import { AppDataSource } from './shared/database/typeorm.datasource';
{{/if}}
{{#if ormMongoose}}
import { connectMongoose } from './shared/database/mongoose.connection';
{{/if}}

async function bootstrap() {
{{#if ormTypeorm}}
  await AppDataSource.initialize();
  console.log('Data source initialized');
{{/if}}
{{#if ormMongoose}}
  await connectMongoose();
  console.log('Mongoose connected');
{{/if}}

  const server = await initGateway();
  await server.start();
  console.log(`Gateway running on ${server.info.uri}`);
{{#each modules}}
  console.log(`Service '{{this}}' mounted at /{{this}}`);
{{/each}}
}

process.on('unhandledRejection', (err) => {
  console.error('Unhandled rejection:', err);
  process.exit(1);
});

bootstrap().catch((err) => {
  console.error('Failed to start:', err);
  process.exit(1);
});
