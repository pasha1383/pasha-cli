import { Request, ResponseToolkit } from '@hapi/hapi';
import type { ServerRoute } from '@hapi/hapi';
{{#if ormPrisma}}
import { prisma } from '../database/prisma.client';
{{/if}}
{{#if ormTypeorm}}
import { AppDataSource } from '../database/typeorm.datasource';
{{/if}}
{{#if ormMongoose}}
import mongoose from 'mongoose';
{{/if}}
{{#if useRedis}}
import { redis } from '../cache/redis.client';
{{/if}}

/**
 * GET /health
 *
 * Reports liveness and readiness. Orchestrators (K8s, ECS, Docker Compose
 * healthcheck) poll this every few seconds, so each check is intentionally
 * cheap — no expensive queries, no heavy computation.
 */
export const healthRoutes: ServerRoute[] = [
  {
    method: 'GET',
    path: '/health',
    handler: async (_request: Request, h: ResponseToolkit) => {
      const checks: Record<string, string> = {};

      const mem = process.memoryUsage();
      checks.heapUsedMB = Math.round(mem.heapUsed / (1024 * 1024)).toString();

{{#if ormPrisma}}
      try {
        await prisma.$executeRawUnsafe('SELECT 1');
        checks.database = 'ok';
      } catch {
        checks.database = 'error';
      }
{{/if}}
{{#if ormTypeorm}}
      try {
        await AppDataSource.query('SELECT 1');
        checks.database = 'ok';
      } catch {
        checks.database = 'error';
      }
{{/if}}
{{#if ormMongoose}}
      checks.database = mongoose.connection.readyState === 1 ? 'ok' : 'error';
{{/if}}
{{#if useRedis}}
      try {
        await redis.ping();
        checks.redis = 'ok';
      } catch {
        checks.redis = 'error';
      }
{{/if}}

      const allOk = Object.values(checks).every((v) => v === 'ok');
      return h.response({ status: allOk ? 'ok' : 'degraded', checks }).code(allOk ? 200 : 503);
    },
  },
];
