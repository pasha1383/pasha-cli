/**
 * Base class for errors meant to reach the client as a specific HTTP status.
 * Services throw these; the onPreResponse extension in server.ts translates
 * them to a response. Anything else thrown is treated as a 500 by Hapi and
 * never leaks its message to the client.
 *
 * Note: Hapi catches all thrown errors, so we extend Error (not Boom).
 * The onPreResponse ext checks `instanceof AppError` to derive the status
 * code from the error instance itself.
 */
export class AppError extends Error {
  constructor(
    message: string,
    public readonly statusCode: number = 400,
  ) {
    super(message);
    this.name = 'AppError';
  }
}

export class NotFoundError extends AppError {
  constructor(message: string) {
    super(message, 404);
    this.name = 'NotFoundError';
  }
}

export class ValidationError extends AppError {
  constructor(message: string) {
    super(message, 422);
    this.name = 'ValidationError';
  }
}
