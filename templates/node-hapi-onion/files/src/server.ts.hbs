import Hapi from '@hapi/hapi';
{{#if useRateLimit}}
import HapiRateLimit from 'hapi-rate-limit';
{{/if}}
import { env } from './config/env';
{{#if useSwagger}}
import { inertPlugin, visionPlugin, swaggerPlugin } from './plugins/swagger';
{{/if}}
{{#if useAuth}}
import { authPlugin } from './plugins/auth';
{{/if}}
{{#if useHealthCheck}}
import { healthRoutes } from './shared/health/health.routes';
{{/if}}
{{#each modules}}
{{#if ../ormPrisma}}
import { {{pascalCase this}}PrismaRepository } from './infrastructure/persistence/{{this}}.prisma.repository';
{{/if}}
{{#if ../ormTypeorm}}
import { {{pascalCase this}}TypeormRepository } from './infrastructure/persistence/{{this}}.typeorm.repository';
{{/if}}
{{#if ../ormMongoose}}
import { {{pascalCase this}}MongooseRepository } from './infrastructure/persistence/{{this}}.mongoose.repository';
{{/if}}
{{#if ../ormNone}}
import { {{pascalCase this}}InMemoryRepository } from './infrastructure/persistence/{{this}}.repository';
{{/if}}
import { {{pascalCase this}}Service } from './application/services/{{this}}.service';
import { {{pascalCase this}}Handler } from './presentation/{{this}}/{{this}}.handler';
import { {{camelCase this}}Routes } from './presentation/{{this}}/{{this}}.routes';
{{/each}}

export async function initServer(): Promise<Hapi.Server> {
  const server = Hapi.server({
    port: env.port,
    host: 'localhost',
    routes: {
      cors: true,
      validate: {
        failAction: async (request, h, err) => {
          throw err;
        },
      },
    },
  });

{{#if useRateLimit}}
  await server.register({
    plugin: HapiRateLimit,
    options: {
      enabled: true,
      userLimit: env.rateLimitMax,
    },
  });
{{/if}}

{{#if useSwagger}}
  await server.register([inertPlugin, visionPlugin, swaggerPlugin]);
{{/if}}

{{#if useAuth}}
  await server.register([authPlugin]);
{{/if}}

{{#if useHealthCheck}}
  server.route(healthRoutes);
{{/if}}

{{#each modules}}
  {{#if ../ormPrisma}}
  const {{camelCase this}}Repo = new {{pascalCase this}}PrismaRepository();
  {{/if}}
  {{#if ../ormTypeorm}}
  const {{camelCase this}}Repo = new {{pascalCase this}}TypeormRepository();
  {{/if}}
  {{#if ../ormMongoose}}
  const {{camelCase this}}Repo = new {{pascalCase this}}MongooseRepository();
  {{/if}}
  {{#if ../ormNone}}
  const {{camelCase this}}Repo = new {{pascalCase this}}InMemoryRepository();
  {{/if}}
  const {{camelCase this}}Service = new {{pascalCase this}}Service({{camelCase this}}Repo);
  const {{camelCase this}}Handler = new {{pascalCase this}}Handler({{camelCase this}}Service);
  server.route({{camelCase this}}Routes({{camelCase this}}Handler));
{{/each}}

  server.ext('onPreResponse', (request, h) => {
    const response = request.response;

    if (response.isBoom) {
      const statusCode = response.output.statusCode;
      if (statusCode >= 500) {
        console.error(response);
        const message = env.nodeEnv === 'production' ? 'Internal server error' : response.message;
        return h.response({ error: message }).code(statusCode);
      }
    }

    return h.continue;
  });

  await server.initialize();
  return server;
}
