# ---- app ----
NODE_ENV=development
PORT=3000

{{#if hasDatabase}}
# ---- database ----
{{#if dbSqlite}}
DB_FILE=./data/{{snakeCase projectName}}.sqlite
{{else}}
{{#if dbPostgres}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{snakeCase projectName}}
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME={{snakeCase projectName}}
{{/if}}
{{#if dbMysql}}
DATABASE_URL=mysql://root:root@localhost:3306/{{snakeCase projectName}}
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME={{snakeCase projectName}}
{{/if}}
{{#if dbMongo}}
DATABASE_URL=mongodb://localhost:27017/{{snakeCase projectName}}
DB_HOST=localhost
DB_PORT=27017
DB_NAME={{snakeCase projectName}}
{{/if}}
{{/if}}
{{/if}}
{{#if useRedis}}

# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
{{/if}}
{{#if useAuth}}

# ---- auth ----
# Change this before deploying anywhere real.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
ADMIN_USER=admin
ADMIN_PASSWORD=admin
{{/if}}
{{#if useRateLimit}}

# ---- rate limiting ----
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
{{/if}}
