import { Request, ResponseToolkit } from '@hapi/hapi';
{{#if useZod}}
import { create{{pascalCase moduleName}}Schema } from './{{moduleName}}.validation';
{{/if}}
import { AppError } from '../../errors/app-error';
import { {{pascalCase moduleName}}Service } from './{{moduleName}}.service';

export class {{pascalCase moduleName}}Handler {
  constructor(private readonly service: {{pascalCase moduleName}}Service) {}

  create = async (request: Request, h: ResponseToolkit) => {
    try {
{{#if useZod}}
      const payload = create{{pascalCase moduleName}}Schema.parse(request.payload);
      const entity = await this.service.create(payload);
{{else}}
      const entity = await this.service.create(request.payload as { name: string });
{{/if}}
      return h.response(entity).code(201);
    } catch (err) {
      if (err instanceof AppError) {
        return h.response({ error: err.message }).code(err.statusCode);
      }
      throw err;
    }
  };

  findAll = async (_request: Request, h: ResponseToolkit) => {
    try {
      const entities = await this.service.findAll();
      return h.response(entities).code(200);
    } catch (err) {
      if (err instanceof AppError) {
        return h.response({ error: err.message }).code(err.statusCode);
      }
      throw err;
    }
  };

  findOne = async (request: Request, h: ResponseToolkit) => {
    try {
      const entity = await this.service.findOne(request.params.id);
      return h.response(entity).code(200);
    } catch (err) {
      if (err instanceof AppError) {
        return h.response({ error: err.message }).code(err.statusCode);
      }
      throw err;
    }
  };
}
