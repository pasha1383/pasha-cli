{{#if ormMongoose}}
import { {{pascalCase moduleName}}, {{pascalCase moduleName}}Model } from './{{moduleName}}.entity';

export class {{pascalCase moduleName}}Repository {
  async save(entity: {{pascalCase moduleName}}): Promise<void> {
    await {{pascalCase moduleName}}Model.updateOne(
      { id: entity.id },
      { $set: { id: entity.id, name: entity.name } },
      { upsert: true },
    );
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    const rows: { id: string; name: string }[] = await {{pascalCase moduleName}}Model.find().lean();
    return rows.map((r) => new {{pascalCase moduleName}}(r.id, r.name));
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    const row: { id: string; name: string } | null = await {{pascalCase moduleName}}Model.findOne({ id }).lean();
    return row ? new {{pascalCase moduleName}}(row.id, row.name) : null;
  }
}
{{/if}}
{{#if ormNone}}
import { {{pascalCase moduleName}} } from './{{moduleName}}.entity';

export class {{pascalCase moduleName}}Repository {
  private readonly items = new Map<string, {{pascalCase moduleName}}>();

  async save(entity: {{pascalCase moduleName}}): Promise<void> {
    this.items.set(entity.id, entity);
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    return Array.from(this.items.values());
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    return this.items.get(id) ?? null;
  }
}
{{/if}}
