import swaggerJsdoc from 'swagger-jsdoc';
import Koa from 'koa';
import { koaSwagger } from 'koa2-swagger-ui';

export function setupSwagger(app: Koa): void {
  const options: swaggerJsdoc.Options = {
    definition: {
      openapi: '3.0.3',
      info: {
        title: '{{projectName}}',
        description: '{{description}}',
        version: '0.1.0',
      },
{{#if useAuth}}
      components: {
        securitySchemes: {
          bearer: {
            type: 'http',
            scheme: 'bearer',
            bearerFormat: 'JWT',
          },
        },
      },
{{/if}}
    },
    apis: ['./src/routes/**/*.ts'],
  };

  const specs = swaggerJsdoc(options);
  app.use(
    koaSwagger({
      routePrefix: '/api/docs',
      swaggerOptions: { spec: specs as Record<string, unknown> },
      hideTopbar: true,
    }),
  );
}
