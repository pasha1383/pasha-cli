import request from 'supertest';
import { createApp } from '../src/app';

describe('App (e2e)', () => {
  const app = createApp();

{{#if useHealthCheck}}
  it('/health (GET) reports the app is up', async () => {
    const res = await request(app.callback()).get('/health').expect(200);
    expect(res.body.status).toBe('ok');
  });
{{/if}}
{{#each modules}}
  it('/{{this}} (GET) returns a list', async () => {
    const res = await request(app.callback()).get('/{{this}}').expect(200);
    expect(Array.isArray(res.body)).toBe(true);
  });
{{/each}}
});
