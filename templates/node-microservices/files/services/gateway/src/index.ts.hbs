import express, { Request, Response, NextFunction } from 'express';
import { createProxyMiddleware, Options } from 'http-proxy-middleware';

const app = express();
const PORT = process.env.GATEWAY_PORT ? parseInt(process.env.GATEWAY_PORT, 10) : 8080;

const proxyConfig: Options = {
  changeOrigin: true,
  logLevel: 'warn',
  on: {
    error: (err, _req, res) => {
      const r = res as any;
      if (r.writeHead && !r.headersSent) {
        r.writeHead(502, { 'Content-Type': 'application/json' });
        r.end(JSON.stringify({ error: 'Bad Gateway', message: err.message }));
      }
    },
  },
};

app.use('/api/a', createProxyMiddleware({ ...proxyConfig, target: 'http://service-a:3001' }));
app.use('/api/b', createProxyMiddleware({ ...proxyConfig, target: 'http://service-b:3002' }));

app.get('/health', async (_req: Request, res: Response) => {
  const services: Record<string, string> = {
    'service-a': 'http://service-a:3001/health',
    'service-b': 'http://service-b:3002/health',
  };

  const statuses: Record<string, string> = {};
  for (const [name, url] of Object.entries(services)) {
    try {
      const resp = await fetch(url, { signal: AbortSignal.timeout(3000) });
      statuses[name] = resp.ok ? 'healthy' : 'unhealthy';
    } catch {
      statuses[name] = 'unreachable';
    }
  }

  const allHealthy = Object.values(statuses).every((s) => s === 'healthy');
  res.status(allHealthy ? 200 : 503).json({
    status: allHealthy ? 'ok' : 'degraded',
    gateway: 'healthy',
    services: statuses,
  });
});

app.use((_req: Request, res: Response) => {
  res.status(404).json({ error: 'Not Found' });
});

app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
  console.error('Gateway error:', err.message);
  res.status(500).json({ error: 'Internal Server Error' });
});

app.listen(PORT, () => {
  console.log(`Gateway listening on port ${PORT}`);
});
