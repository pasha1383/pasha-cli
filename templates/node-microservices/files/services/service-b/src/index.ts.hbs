import express, { Request, Response, NextFunction } from 'express';

const app = express();
const PORT = process.env.SERVICE_B_PORT ? parseInt(process.env.SERVICE_B_PORT, 10) : 3002;

app.use(express.json());

app.get('/health', (_req: Request, res: Response) => {
  res.json({ status: 'ok', service: 'service-b' });
});

app.get('/api/b/items', (_req: Request, res: Response) => {
  res.json({ service: 'service-b', data: [] });
});

app.get('/api/b/items/:id', (req: Request, res: Response) => {
  res.json({ service: 'service-b', id: req.params.id });
});

app.use((_req: Request, res: Response) => {
  res.status(404).json({ error: 'Not Found' });
});

app.use((err: Error, _req: Request, res: Response, _next: NextFunction) => {
  console.error('Service B error:', err.message);
  res.status(500).json({ error: 'Internal Server Error' });
});

app.listen(PORT, () => {
  console.log(`Service B listening on port ${PORT}`);
});
