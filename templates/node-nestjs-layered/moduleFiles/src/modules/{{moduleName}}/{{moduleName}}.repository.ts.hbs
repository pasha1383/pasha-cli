{{#if ormPrisma}}
import { Injectable } from '@nestjs/common';
import { {{pascalCase moduleName}} } from './entities/{{moduleName}}.entity';
import { PrismaService } from '../../shared/database/prisma.service';

@Injectable()
export class {{pascalCase moduleName}}Repository {
  constructor(private readonly prisma: PrismaService) {}

  async save(entity: {{pascalCase moduleName}}): Promise<void> {
    await this.prisma.{{camelCase moduleName}}.upsert({
      where: { id: entity.id },
      create: { id: entity.id, name: entity.name },
      update: { name: entity.name },
    });
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    const rows = await this.prisma.{{camelCase moduleName}}.findMany();
    return rows.map((r: { id: string; name: string }) => new {{pascalCase moduleName}}(r.id, r.name));
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    const row = await this.prisma.{{camelCase moduleName}}.findUnique({ where: { id } });
    return row ? new {{pascalCase moduleName}}(row.id, row.name) : null;
  }
}
{{/if}}
