{{#if ormMongoose}}
import { Injectable } from '@nestjs/common';
import { InjectModel } from '@nestjs/mongoose';
import { Model } from 'mongoose';
import { {{pascalCase moduleName}} } from './entities/{{moduleName}}.entity';

@Injectable()
export class {{pascalCase moduleName}}Repository {
  constructor(
    @InjectModel({{pascalCase moduleName}}.name)
    private readonly model: Model<{{pascalCase moduleName}}>,
  ) {}

  async save(entity: {{pascalCase moduleName}}): Promise<void> {
    await this.model.updateOne(
      { id: entity.id },
      { $set: { id: entity.id, name: entity.name } },
      { upsert: true },
    );
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    // lean() returns plain objects; typing it explicitly keeps this stable
    // across mongoose versions, whose lean() generics change between majors.
    const rows: {{pascalCase moduleName}}[] = await this.model.find().lean();
    return rows;
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    const row: {{pascalCase moduleName}} | null = await this.model.findOne({ id }).lean();
    return row;
  }
}
{{/if}}
{{#if ormNone}}
import { Injectable } from '@nestjs/common';
import { {{pascalCase moduleName}} } from './entities/{{moduleName}}.entity';

@Injectable()
export class {{pascalCase moduleName}}Repository {
  private readonly items = new Map<string, {{pascalCase moduleName}}>();

  async save(entity: {{pascalCase moduleName}}): Promise<void> {
    this.items.set(entity.id, entity);
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    return Array.from(this.items.values());
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    return this.items.get(id) ?? null;
  }
}
{{/if}}
