{{#if ormNone}}
import { Injectable } from '@nestjs/common';
import { {{pascalCase moduleName}} } from './entities/{{moduleName}}.entity';
import { Create{{pascalCase moduleName}}Dto } from './dto/create-{{moduleName}}.dto';
import { randomUUID } from 'crypto';

@Injectable()
export class {{pascalCase moduleName}}Repository {
  private readonly items = new Map<string, {{pascalCase moduleName}}>();

  create(dto: Create{{pascalCase moduleName}}Dto): {{pascalCase moduleName}} {
    return new {{pascalCase moduleName}}(randomUUID(), dto.name);
  }

  async save(entity: {{pascalCase moduleName}}): Promise<{{pascalCase moduleName}}> {
    this.items.set(entity.id, entity);
    return entity;
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    return Array.from(this.items.values());
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    return this.items.get(id) ?? null;
  }
}
{{/if}}
