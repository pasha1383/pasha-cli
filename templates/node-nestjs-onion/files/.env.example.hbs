# Environment
PORT=3000
NODE_ENV=development

{{#if hasDatabase}}
# Database
{{#if ormPrisma}}
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/{{projectName}}"
{{/if}}
{{#if ormTypeorm}}
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME={{projectName}}
{{/if}}
{{#if ormMongoose}}
MONGO_URI=mongodb://localhost:27017/{{projectName}}
{{/if}}
{{/if}}

{{#if useRedis}}
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
{{/if}}

{{#if useAuth}}
# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
ADMIN_USER=admin
ADMIN_PASS=admin
CORS_ORIGIN=http://localhost:3000
{{/if}}

{{#if hasBroker}}
# Messaging
{{#if useKafka}}
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID={{projectName}}
{{/if}}
{{#if useRabbitmq}}
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE={{projectName}}
{{/if}}
{{/if}}
