import { Controller, Get } from '@nestjs/common';
{{#if useSwagger}}
import { ApiTags } from '@nestjs/swagger';
{{/if}}
import { HealthCheck, HealthCheckService, MemoryHealthIndicator } from '@nestjs/terminus';
{{#if ormPrisma}}
import { PrismaHealthIndicator } from '../../shared/health/indicators/prisma.health-indicator';
{{/if}}
{{#if ormTypeorm}}
import { TypeormHealthIndicator } from '../../shared/health/indicators/typeorm.health-indicator';
{{/if}}
{{#if ormMongoose}}
import { MongooseHealthIndicatorService } from '../../shared/health/indicators/mongoose.health-indicator';
{{/if}}
{{#if healthChecksRedis}}
import { RedisHealthIndicator } from '../../shared/health/indicators/redis.health-indicator';
{{/if}}

{{#if useSwagger}}
@ApiTags('health')
{{/if}}
@Controller('health')
export class HealthController {
  constructor(
    private readonly health: HealthCheckService,
    private readonly memory: MemoryHealthIndicator,
{{#if ormPrisma}}
    private readonly prismaIndicator: PrismaHealthIndicator,
{{/if}}
{{#if ormTypeorm}}
    private readonly typeormIndicator: TypeormHealthIndicator,
{{/if}}
{{#if ormMongoose}}
    private readonly mongooseIndicator: MongooseHealthIndicatorService,
{{/if}}
{{#if healthChecksRedis}}
    private readonly redisIndicator: RedisHealthIndicator,
{{/if}}
  ) {}

  @Get()
  @HealthCheck()
  check() {
    return this.health.check([
      () => this.memory.checkHeap('memory_heap', 300 * 1024 * 1024),
{{#if ormPrisma}}
      () => this.prismaIndicator.isHealthy('database'),
{{/if}}
{{#if ormTypeorm}}
      () => this.typeormIndicator.isHealthy('database'),
{{/if}}
{{#if ormMongoose}}
      () => this.mongooseIndicator.isHealthy('database'),
{{/if}}
{{#if healthChecksRedis}}
      () => this.redisIndicator.isHealthy('redis'),
{{/if}}
    ]);
  }
}
