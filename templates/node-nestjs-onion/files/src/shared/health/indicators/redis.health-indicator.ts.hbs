import { Injectable } from '@nestjs/common';
import {
  HealthIndicator,
  HealthIndicatorResult,
  HealthCheckError,
} from '@nestjs/terminus';
import { RedisService } from '../../../shared/cache/redis.service';

@Injectable()
export class RedisHealthIndicator extends HealthIndicator {
  constructor(private readonly redisService: RedisService) {
    super();
  }

  async isHealthy(key: string): Promise<HealthIndicatorResult> {
    try {
      await this.redisService.set('health:check', 'ok', 10);
      const value = await this.redisService.get('health:check');
      const isHealthy = value === 'ok';
      if (isHealthy) {
        return this.getStatus(key, true);
      }
      throw new Error('Redis ping returned unexpected value');
    } catch (error) {
      throw new HealthCheckError(
        'Redis check failed',
        this.getStatus(key, false, { error: (error as Error).message }),
      );
    }
  }
}
