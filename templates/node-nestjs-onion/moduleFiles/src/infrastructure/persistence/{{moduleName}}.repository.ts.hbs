{{#if ormNone}}
import { Injectable } from '@nestjs/common';
import { {{pascalCase moduleName}} } from '../../domain/entities/{{moduleName}}.entity';
import { I{{pascalCase moduleName}}Repository } from '../../domain/repositories/{{moduleName}}.repository.interface';

@Injectable()
export class {{pascalCase moduleName}}Repository implements I{{pascalCase moduleName}}Repository {
  private readonly items = new Map<string, {{pascalCase moduleName}}>();

  async save(entity: {{pascalCase moduleName}}): Promise<void> {
    this.items.set(entity.id, entity);
  }

  async findAll(): Promise<{{pascalCase moduleName}}[]> {
    return Array.from(this.items.values());
  }

  async findById(id: string): Promise<{{pascalCase moduleName}} | null> {
    return this.items.get(id) ?? null;
  }
}
