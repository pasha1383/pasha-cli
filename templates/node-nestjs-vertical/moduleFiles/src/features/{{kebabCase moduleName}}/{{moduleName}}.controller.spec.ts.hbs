      findAll: jest.fn().mockResolvedValue([{ id: '1', name: 'test' }]),
      findOne: jest.fn().mockResolvedValue({ id: '1', name: 'test' }),
    };

    const module: TestingModule = await Test.createTestingModule({
      controllers: [{{pascalCase moduleName}}Controller],
      providers: [
        { provide: {{pascalCase moduleName}}Handler, useValue: handler },
      ],
    }).compile();

    controller = module.get({{pascalCase moduleName}}Controller);
  });

  it('creates an entity and returns a response', async () => {
    const result = await controller.create({ name: 'test' } as any);
    expect(handler.create).toHaveBeenCalled();
    expect(result).toEqual({ id: '1', name: 'test' });
