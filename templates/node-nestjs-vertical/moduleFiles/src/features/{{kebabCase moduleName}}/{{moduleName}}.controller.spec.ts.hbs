import { Test, TestingModule } from '@nestjs/testing';
import { {{pascalCase moduleName}}Handler } from './{{moduleName}}.handler';
import { {{pascalCase moduleName}}Repository } from './{{moduleName}}.repository';
import { {{pascalCase moduleName}}Controller } from './{{moduleName}}.controller';

describe('{{pascalCase moduleName}}Controller', () => {
  let controller: {{pascalCase moduleName}}Controller;
  let handler: { create: jest.Mock; findAll: jest.Mock; findOne: jest.Mock };

  beforeEach(async () => {
    handler = {
