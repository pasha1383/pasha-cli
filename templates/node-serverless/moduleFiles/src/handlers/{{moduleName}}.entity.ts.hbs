{{#if ormPrisma}}
import { prisma } from '../../lib/database/prisma.client';
import { Create{{pascalCase moduleName}}Input, {{pascalCase moduleName}}Data } from '../../types/{{moduleName}}';

export class {{pascalCase moduleName}}Repository {
  async create(input: Create{{pascalCase moduleName}}Input): Promise<{{pascalCase moduleName}}Data> {
    const row = await prisma.{{camelCase moduleName}}.create({
      data: { name: input.name },
    });
    return { id: row.id, name: row.name };
  }

  async findAll(): Promise<{{pascalCase moduleName}}Data[]> {
    const rows = await prisma.{{camelCase moduleName}}.findMany();
    return rows.map((r) => ({ id: r.id, name: r.name }));
  }

  async findById(id: string): Promise<{{pascalCase moduleName}}Data | null> {
    const row = await prisma.{{camelCase moduleName}}.findUnique({ where: { id } });
    return row ? { id: row.id, name: row.name } : null;
  }
}
