{
  "name": "PHP + Laravel + Clean Architecture",
  "prerequisites": ["php", "composer", "git"],
  "shared": null,
  "stackFeatures": "laravel",
  "modules": {
    "enabled": true,
    "message": "Module/entity name (e.g. product, user, order)",
    "default": "product"
  },
  "fileConditions": {
    "docker-compose.yml.hbs": "useDocker",
    ".github": "useCI",
    "Dockerfile.hbs": "useAppDockerfile",
    ".dockerignore.hbs": "useAppDockerfile",
    "config/l5-swagger.php.hbs": "useSwagger",
    "app/Http/Middleware/Authenticate.php.hbs": "useAuth",
    "app/Providers/AuthServiceProvider.php.hbs": "useAuth",
    "app/Http/Controllers/HealthController.php.hbs": "useHealthCheck",
    "pint.json.hbs": "useLint",
    "app/Providers/RateLimitServiceProvider.php.hbs": "useRateLimit",
    "config/throttle.php.hbs": "useRateLimit",
    "phpunit.xml.hbs": "useTests",
    "tests": "useTests",
    "src/Infrastructure/Http/Requests/Store{{pascalCase moduleName}}Request.php.hbs": "hasValidation",
    "src/Infrastructure/Http/Requests/Update{{pascalCase moduleName}}Request.php.hbs": "hasValidation",
    "src/Domain/{{pascalCase moduleName}}Entity.php.hbs": "true",
    "src/Domain/{{pascalCase moduleName}}RepositoryInterface.php.hbs": "true",
    "src/Application/UseCases/Create{{pascalCase moduleName}}UseCase.php.hbs": "true",
    "src/Application/UseCases/Get{{pascalCase moduleName}}UseCase.php.hbs": "true",
    "src/Application/UseCases/Update{{pascalCase moduleName}}UseCase.php.hbs": "true",
    "src/Application/UseCases/Delete{{pascalCase moduleName}}UseCase.php.hbs": "true",
    "src/Infrastructure/Http/Controllers/{{pascalCase moduleName}}Controller.php.hbs": "true",
    "src/Infrastructure/Http/Resources/{{pascalCase moduleName}}Resource.php.hbs": "true",
    "src/Infrastructure/Providers/{{pascalCase moduleName}}ServiceProvider.php.hbs": "true",
    "src/Infrastructure/Persistence/Eloquent{{pascalCase moduleName}}Model.php.hbs": "ormEloquent",
    "src/Infrastructure/Persistence/Eloquent{{pascalCase moduleName}}Repository.php.hbs": "ormEloquent",
    "database/migrations/{{yyyy}}_{{mm}}_{{dd}}_{{timestamp}}_create_{{snakeCase moduleName}}_table.php.hbs": "ormEloquent",
    "tests/Feature/{{pascalCase moduleName}}Test.php.hbs": "useTests"
  },
  "postInstall": ["composer install"],
  "gitInit": true
}
