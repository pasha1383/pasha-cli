name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: 'pip'

      - run: pip install -r requirements.txt
      {{#if devRequirementsTxt}}
      - run: pip install -r dev-requirements.txt
      {{/if}}

{{#if useLint}}
      - name: Lint
        run: ruff check .
{{/if}}
{{#if useTests}}
      - name: Test
        run: python manage.py test
{{/if}}
