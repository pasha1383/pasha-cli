"""FastAPI application factory — hexagonal/DDD architecture."""

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
{{#if useRateLimit}}
from slowapi import _rate_limit_exceeded_handler
from slowapi.errors import RateLimitExceeded
from slowapi.middleware import SlowAPIMiddleware
from slowapi.util import get_remote_address
from slowapi import Limiter
{{/if}}

from src.config.settings import settings
from src.errors.app_error import AppError
from src.shared.database.{{#if ormSqlalchemy}}sqlalchemy{{else if ormTortoise}}tortoise{{else}}none{{/if}} import init_db, close_db
{{#if useRedis}}
from src.shared.cache.redis_client import get_redis
{{/if}}
{{#if useAuth}}
from src.shared.auth.auth_dependency import auth_router
{{/if}}
{{#if useHealthCheck}}
from src.shared.health.health_router import health_router
{{/if}}
{{#each modules}}
from src.infrastructure.{{snakeCase this}}.{{this}}_controller import router as {{camelCase this}}_router
{{/each}}


def create_app() -> FastAPI:
    app = FastAPI(
        title="{{projectName}}",
        description="{{description}}",
        version="0.1.0",
        {{#if useSwagger}}
        docs_url="/docs",
        redoc_url="/redoc",
        {{/if}}
    )

    app.add_middleware(
        CORSMiddleware,
        allow_origins=["*"] if settings.app_env == "development" else [],
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )

    {{#if useRateLimit}}
    limiter = Limiter(key_func=get_remote_address)
    app.state.limiter = limiter
    app.add_exception_handler(RateLimitExceeded, _rate_limit_exceeded_handler)
    app.add_middleware(SlowAPIMiddleware)
    {{/if}}

    @app.on_event("startup")
    async def startup():
        await init_db(settings)

    @app.on_event("shutdown")
    async def shutdown():
        await close_db()
        {{#if useRedis}}
        r = await get_redis()
        if r:
            await r.close()
        {{/if}}

    {{#if useAuth}}
    app.include_router(auth_router, prefix="/auth", tags=["auth"])
    {{/if}}
    {{#if useHealthCheck}}
    app.include_router(health_router, prefix="/health", tags=["health"])
    {{/if}}
    {{#each modules}}
    app.include_router({{camelCase this}}_router, prefix="/{{this}}", tags=["{{this}}"])
    {{/each}}

    @app.exception_handler(AppError)
    async def app_error_handler(request, exc: AppError):
        from starlette.responses import JSONResponse
        return JSONResponse(
            status_code=exc.status_code,
            content={"error": exc.message, "status_code": exc.status_code},
        )

    return app
