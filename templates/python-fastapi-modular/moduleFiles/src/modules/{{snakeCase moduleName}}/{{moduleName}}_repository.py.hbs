        self._items: dict[int, {{pascalCase moduleName}}] = {}
        self._next_id = 1

    async def save(self, entity: {{pascalCase moduleName}}) -> {{pascalCase moduleName}}:
        if entity.id == 0:
            entity.id = self._next_id
            self._next_id += 1
        self._items[entity.id] = entity
