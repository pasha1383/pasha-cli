# ---- app ----
APP_ENV=development
APP_PORT=8000

{{#if hasDatabase}}
# ---- database ----
{{#if dbSqlite}}
DATABASE_URL=sqlite+aiosqlite:///./data/{{snakeCase projectName}}.sqlite
{{/if}}
{{#if dbPostgres}}
DATABASE_URL=postgresql+asyncpg://{{dbName}}:postgres@localhost:5432/{{dbName}}
DB_HOST=localhost
DB_PORT=5432
DB_USER={{dbName}}
DB_PASSWORD=postgres
DB_NAME={{dbName}}
{{/if}}
{{#if dbMysql}}
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/{{dbName}}
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME={{dbName}}
{{/if}}
{{/if}}
{{#if useRedis}}

# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
{{/if}}
{{#if useKafka}}

# ---- kafka ----
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID={{projectName}}-consumer
{{/if}}
{{#if useRabbitmq}}

# ---- rabbitmq ----
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE={{projectName}}-queue
{{/if}}
{{#if useAuth}}

# ---- auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
{{/if}}
{{#if useRateLimit}}

# ---- rate limiting ----
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100
{{/if}}
