# ---- app ----
APP_ENV=development
APP_PORT=5000
FLASK_APP=app:create_app

{{#if hasDatabase}}
# ---- database ----
{{#if dbSqlite}}
DATABASE_URL=sqlite:///./data/{{snakeCase projectName}}.sqlite
{{/if}}
{{#if dbPostgres}}
DATABASE_URL=postgresql://{{dbName}}:postgres@localhost:5432/{{dbName}}
DB_HOST=localhost
DB_PORT=5432
DB_USER={{dbName}}
DB_PASSWORD=postgres
DB_NAME={{dbName}}
{{/if}}
{{#if dbMysql}}
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/{{dbName}}
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME={{dbName}}
{{/if}}
{{/if}}
