from os import environ
from secrets import token_hex

from dotenv import load_dotenv

load_dotenv()


class Settings:
    app_env: str = environ.get("APP_ENV", "development")
    app_port: int = int(environ.get("APP_PORT", "5000"))
    secret_key: str = environ.get("SECRET_KEY", token_hex(32))

    {{#if hasDatabase}}
    database_url: str = environ.get("DATABASE_URL", "{{#if dbSqlite}}sqlite:///./data/{{snakeCase projectName}}.sqlite{{/if}}{{#if dbPostgres}}postgresql://{{dbName}}:postgres@localhost:5432/{{dbName}}{{/if}}{{#if dbMysql}}mysql+pymysql://root:root@localhost:3306/{{dbName}}{{/if}}")
    {{/if}}


settings = Settings()
