from src.core.domain.{{snakeCase moduleName}}.entity import {{pascalCase moduleName}} as {{pascalCase moduleName}}Entity
from src.core.domain.{{snakeCase moduleName}}.repository_interface import {{pascalCase moduleName}}RepositoryInterface


class {{pascalCase moduleName}}Repository({{pascalCase moduleName}}RepositoryInterface):
    def __init__(self):
        self._items: dict[int, {{pascalCase moduleName}}Entity] = {}
        self._next_id = 1

    def save(self, entity: {{pascalCase moduleName}}Entity) -> {{pascalCase moduleName}}Entity:
        if entity.id == 0:
            entity.id = self._next_id
            self._next_id += 1
        self._items[entity.id] = entity
        return entity

    def find_all(self) -> list[{{pascalCase moduleName}}Entity]:
        return list(self._items.values())

    def find_by_id(self, pk: int) -> {{pascalCase moduleName}}Entity | None:
        return self._items.get(pk)

    def delete(self, pk: int) -> None:
        self._items.pop(pk, None)
