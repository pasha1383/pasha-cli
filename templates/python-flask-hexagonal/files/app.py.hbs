"""Flask application factory."""

from flask import Flask, jsonify
from flask_cors import CORS

from src.config.settings import settings
from src.errors.app_error import AppError
{{#if ormSqlalchemy}}
from src.shared.database.sqlalchemy import db, init_db
{{/if}}
{{#each modules}}
from src.infrastructure.{{snakeCase this}} import {{camelCase this}}_bp
{{/each}}


def create_app() -> Flask:
    app = Flask(__name__)
    app.config.from_mapping(
        SECRET_KEY=settings.secret_key,
        {{#if ormSqlalchemy}}
        SQLALCHEMY_DATABASE_URI=settings.database_url,
        SQLALCHEMY_TRACK_MODIFICATIONS=False,
        {{/if}}
    )

    CORS(app)

    {{#if ormSqlalchemy}}
    init_db(app)
    {{/if}}

    {{#each modules}}
    app.register_blueprint({{camelCase this}}_bp, url_prefix="/{{this}}")
    {{/each}}

    @app.errorhandler(AppError)
    def handle_app_error(error: AppError):
        return jsonify({"error": error.message, "status_code": error.status_code}), error.status_code

    @app.route("/")
    def root():
        return jsonify({"app": "{{projectName}}", "version": "0.1.0"})

    return app
