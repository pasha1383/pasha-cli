# ---- app ----
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change-me

{{#if hasDatabase}}
# ---- database ----
{{#if dbSqlite}}
DATABASE_URL=sqlite:///./data/db.sqlite3
{{/if}}
{{#if dbPostgres}}
DATABASE_URL=postgresql://{{dbName}}:postgres@localhost:5432/{{dbName}}
DB_HOST=localhost
DB_PORT=5432
DB_USER={{dbName}}
DB_PASSWORD=postgres
DB_NAME={{dbName}}
{{/if}}
{{#if dbMysql}}
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/{{dbName}}
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME={{dbName}}
{{/if}}
{{/if}}
{{#if useRedis}}
# ---- redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
{{/if}}
{{#if useAuth}}
# ---- auth ----
JWT_SECRET=change-me-to-a-long-random-string
{{/if}}
