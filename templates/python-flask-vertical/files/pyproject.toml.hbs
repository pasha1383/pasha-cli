[project]
name = "{{projectName}}"
version = "0.1.0"
description = "{{description}}"
requires-python = ">=3.10"
{{#if useLint}}

[tool.ruff]
target-version = "py310"
line-length = 100
exclude = ["__pycache__", ".venv", "venv"]
{{/if}}
{{#if useTests}}

[tool.pytest.ini_options]
pythonpath = ["src"]
addopts = "-v --tb=short"
testpaths = ["src"]
python_files = ["test_*.py", "*_test.py"]
{{/if}}
