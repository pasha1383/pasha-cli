{
  "name": "React + Vite + Clean Architecture (domain/application/infrastructure/presentation)",
  "prerequisites": ["node", "npm", "git"],
  "shared": null,
  "stackFeatures": "react",
  "modules": {
    "enabled": true,
    "message": "Domain name (e.g. dashboard, profile, order)",
    "default": "dashboard"
  },
  "fileConditions": {
    "tailwind.config.js.hbs": "useTailwind",
    "postcss.config.js.hbs": "useTailwind",
    ".eslintrc.cjs": "useLint",
    ".prettierrc": "useLint",
    "vitest.config.ts.hbs": "useVitest",
    "playwright.config.ts.hbs": "usePlaywright",
    ".storybook": "useStorybook",
    ".storybook/main.ts.hbs": "useStorybook",
    ".storybook/preview.ts.hbs": "useStorybook",
    "src/App.test.tsx.hbs": "useVitest",
    "src/setupTests.ts.hbs": "useVitest",
    "src/presentation/router.tsx.hbs": "useReactRouter",
    "src/infrastructure/http": "useTanstackQuery",
    "src/application/store": "useZustand",
    ".github": "useCI",
    "Dockerfile.hbs": "useDockerfile",
    ".dockerignore.hbs": "useDockerfile",
    "AGENT.md.hbs": "useAgentDocs",
    "src/AGENT.md.hbs": "useAgentDocs"
  },
  "postInstall": ["npm install"],
  "gitInit": true
}
