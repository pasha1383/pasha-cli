{
  "name": "node-nestjs-hexagonal",
  "label": "NestJS + Hexagonal / DDD",
  "language": "node",
  "framework": "nestjs",
  "architecture": "hexagonal",
  "layers": [
    "base",
    "lang/node",
    "framework/nestjs",
    "architecture/hexagonal",
    "feature/prisma",
    "feature/redis",
    "feature/kafka"
  ],
  "fileConditions": {
    "feature/prisma": "ormPrisma",
    "feature/redis": "useRedis",
    "feature/kafka": "useKafka"
  },
  "prerequisites": ["node", "npm", "git"],
  "postInstall": ["npm install"],
  "gitInit": true
}
