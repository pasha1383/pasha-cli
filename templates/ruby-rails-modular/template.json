{
  "name": "Ruby + Rails + Modular Monolith (Engines)",
  "prerequisites": ["ruby", "bundler", "rails", "git"],
  "shared": null,
  "stackFeatures": "rails",
  "modules": {
    "enabled": true,
    "message": "Engine/module name (e.g. product, user, order)",
    "default": "product"
  },
  "fileConditions": {
    "docker-compose.yml.hbs": "useDocker",
    "Dockerfile.hbs": "useAppDockerfile",
    ".dockerignore.hbs": "useAppDockerfile",
    ".github": "useCI",
    "AGENT.md.hbs": "useAgentDocs",
    ".rubocop.yml.hbs": "useLint",
    "config/initializers/sidekiq.rb.hbs": "useSidekiq",
    "config/initializers/devise.rb.hbs": "useAuth",
    "config/initializers/rswag.rb.hbs": "useSwagger",
    "config/initializers/rack_attack.rb.hbs": "useRateLimit",
    "config/initializers/okcomputer.rb.hbs": "useHealthCheck",
    "app/models/application_record.rb.hbs": "ormActiverecord",
    "engines": true,
    "app/jobs": "useSidekiq",
    "spec": "useTests",
    "spec/rails_helper.rb.hbs": "useTests",
    "db": "hasOrm",
    "db/migrate": "hasOrm",
    "db/seeds.rb.hbs": "hasOrm"
  },
  "postInstall": ["bundle install"],
  "gitInit": true
}
