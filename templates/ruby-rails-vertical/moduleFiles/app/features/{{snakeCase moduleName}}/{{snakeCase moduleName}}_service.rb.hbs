class {{pascalCase moduleName}}Service
  def list_all
    {{pascalCase moduleName}}.all.order(created_at: :desc)
  end

  def find(id)
    {{pascalCase moduleName}}.find(id)
  end

  def create(params)
    record = {{pascalCase moduleName}}.new(params)
    record.save!

    record
  rescue ActiveRecord::RecordInvalid => e
