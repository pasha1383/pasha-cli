use self::handler::*;
use self::repository::*;
use self::service::*;

{{#if ormNone}}
pub fn router() -> Router {
    let repo = Arc::new(InMemory{{pascalCase moduleName}}Repository::new());
    let svc = {{pascalCase moduleName}}Service::new(repo);
    let state = {{pascalCase moduleName}}State { svc };

    Router::new()
        .route("/", get(list_{{moduleName}}).post(create_{{moduleName}}))
        .route("/:id", get(get_{{moduleName}}).delete(delete_{{moduleName}}))
        .with_state(state)
}
{{/if}}
