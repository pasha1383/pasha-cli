#[derive(Clone)]
pub struct InMemory{{pascalCase moduleName}}Repository {
    items: Arc<Mutex<Vec<{{pascalCase moduleName}}>>>,
}

impl InMemory{{pascalCase moduleName}}Repository {
    pub fn new() -> Self {
        Self {
            items: Arc::new(Mutex::new(Vec::new())),
        }
    }
}

#[async_trait]
impl {{pascalCase moduleName}}Repository for InMemory{{pascalCase moduleName}}Repository {
    async fn save(&self, entity: &{{pascalCase moduleName}}) -> Result<{{pascalCase moduleName}}, {{pascalCase moduleName}}RepositoryError> {
        let mut items = self.items.lock().await;
        let mut saved = entity.clone();
        if entity.id.is_empty() {
            saved.id = Uuid::new_v4().to_string();
        }
        items.retain(|i| i.id != saved.id);
        items.push(saved.clone());
        Ok(saved)
    }

    async fn find_all(&self) -> Result<Vec<{{pascalCase moduleName}}>, {{pascalCase moduleName}}RepositoryError> {
        let items = self.items.lock().await;
        Ok(items.clone())
    }

    async fn find_by_id(&self, id: &str) -> Result<Option<{{pascalCase moduleName}}>, {{pascalCase moduleName}}RepositoryError> {
        let items = self.items.lock().await;
        Ok(items.iter().find(|i| i.id == id).cloned())
    }

    async fn delete(&self, id: &str) -> Result<(), {{pascalCase moduleName}}RepositoryError> {
        let mut items = self.items.lock().await;
        items.retain(|i| i.id != id);
        Ok(())
    }
}
