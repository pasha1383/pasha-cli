use axum::{
    extract::{Path, State},
    http::StatusCode,
    response::IntoResponse,
    Json,
};
use std::sync::Arc;

use crate::errors::AppError;
use crate::{{moduleName}}::application::service::{{pascalCase moduleName}}Service;
use crate::{{moduleName}}::infrastructure::dto::{Create{{pascalCase moduleName}}Request, {{pascalCase moduleName}}Response};

#[derive(Clone)]
pub struct AppState {
    pub svc: Arc<{{pascalCase moduleName}}Service>,
}

pub async fn list(State(state): State<AppState>) -> impl IntoResponse {
    match state.svc.list().await {
        Ok(items) => (StatusCode::OK, Json(items)).into_response(),
        Err(err) => err.into_response(),
    }
}

pub async fn create(
    State(state): State<AppState>,
    Json(input): Json<Create{{pascalCase moduleName}}Request>,
) -> impl IntoResponse {
{{#if useValidator}}
    if let Err(errors) = input.validate() {
        return (StatusCode::BAD_REQUEST, Json(serde_json::json!({"errors": errors}))).into_response();
    }
{{/if}}
    match state.svc.create(input).await {
        Ok(item) => (StatusCode::CREATED, Json(item)).into_response(),
        Err(err) => err.into_response(),
    }
}

pub async fn get_by_id(
    State(state): State<AppState>,
    Path(id): Path<String>,
) -> impl IntoResponse {
    match state.svc.get_by_id(&id).await {
        Ok(item) => (StatusCode::OK, Json(item)).into_response(),
        Err(err) => err.into_response(),
    }
}

pub async fn delete(
    State(state): State<AppState>,
    Path(id): Path<String>,
) -> impl IntoResponse {
    match state.svc.delete(&id).await {
        Ok(()) => StatusCode::NO_CONTENT.into_response(),
        Err(err) => err.into_response(),
    }
}
