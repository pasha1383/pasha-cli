<script lang="ts">
  interface Props {
    initialCount?: number;
  }

  let { initialCount = 0 }: Props = $props();

  let count = $state(initialCount);

  function increment() {
    count++;
  }

  function decrement() {
    count--;
  }

  function reset() {
    count = initialCount;
  }
</script>

<div class="{{kebabCase moduleName}}">
  <h2>{{pascalCase moduleName}}</h2>
  <p class="count">{count}</p>
  <div class="buttons">
    <button onclick={decrement}>-</button>
    <button onclick={reset}>Reset</button>
    <button onclick={increment}>+</button>
  </div>
</div>

