import { describe, it, expect } from 'vitest';
import { render, screen, fireEvent } from '@testing-library/svelte';
import {{pascalCase moduleName}} from './{{moduleName}}.svelte';

describe('{{pascalCase moduleName}}', () => {
  it('renders with initial count', () => {
    render({{pascalCase moduleName}}, { initialCount: 5 });
    expect(screen.getByText('5')).toBeInTheDocument();
  });

  it('increments count on + click', async () => {
    render({{pascalCase moduleName}}, { initialCount: 0 });
    const incrementBtn = screen.getByText('+');
    await fireEvent.click(incrementBtn);
    expect(screen.getByText('1')).toBeInTheDocument();
  });

  it('decrements count on - click', async () => {
    render({{pascalCase moduleName}}, { initialCount: 5 });
    const decrementBtn = screen.getByText('-');
    await fireEvent.click(decrementBtn);
    expect(screen.getByText('4')).toBeInTheDocument();
  });

  it('resets count to initial value', async () => {
    render({{pascalCase moduleName}}, { initialCount: 10 });
    await fireEvent.click(screen.getByText('+'));
    await fireEvent.click(screen.getByText('+'));
    await fireEvent.click(screen.getByText('Reset'));
    expect(screen.getByText('10')).toBeInTheDocument();
  });
});
