import { createRouter, createWebHistory } from 'vue-router';
{{#each modules}}
import {{pascalCase this}}Page from '@/pages/{{pascalCase this}}/{{pascalCase this}}Page.vue';
{{/each}}

const routes = [
  {{#each modules}}
  {
    path: '/{{this}}',
    name: '{{pascalCase this}}',
    component: {{pascalCase this}}Page,
  },
  {{/each}}
  { path: '/', redirect: '/{{modules.[0]}}' },
];

const router = createRouter({
  history: createWebHistory(),
  routes,
});

export default router;
