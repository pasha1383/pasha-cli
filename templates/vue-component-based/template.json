{
  "name": "Vue 3 + Component-Based (components / composables / views)",
  "prerequisites": ["node", "npm", "git"],
  "shared": null,
  "stackFeatures": "vue",
  "modules": {
    "enabled": true,
    "message": "Module/page name (e.g. dashboard, profile, settings)",
    "default": "dashboard"
  },
  "fileConditions": {
    "tailwind.config.js.hbs": "useTailwind",
    "postcss.config.js.hbs": "useTailwind",
    ".eslintrc.cjs": "useLint",
    ".prettierrc": "useLint",
    "vitest.config.ts.hbs": "useVitest",
    "src/__tests__/App.spec.ts": "useVitest",
    "playwright.config.ts.hbs": "usePlaywright",
    "e2e": "usePlaywright",
    ".storybook": "useStorybook",
    ".storybook/main.ts.hbs": "useStorybook",
    ".storybook/preview.ts.hbs": "useStorybook",
    "src/router/index.ts.hbs": "useRouter",
    "src/stores": "usePinia",
    "src/stores/counter.ts.hbs": "usePinia",
    ".github": "useCI",
    "Dockerfile.hbs": "useAppDockerfile",
    ".dockerignore.hbs": "useAppDockerfile",
    "AGENT.md.hbs": "useAgentDocs"
  },
  "postInstall": ["npm install"],
  "gitInit": true
}
