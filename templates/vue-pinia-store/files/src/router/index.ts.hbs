import { createRouter, createWebHistory } from 'vue-router';
{{#each modules}}
import {{pascalCase this}}View from '@/views/{{pascalCase this}}View.vue';
{{/each}}

const routes = [
  {{#each modules}}
  { path: '/{{this}}', name: '{{pascalCase this}}', component: {{pascalCase this}}View },
  {{/each}}
  { path: '/', redirect: '/{{modules.[0]}}' },
];

const router = createRouter({
  history: createWebHistory(),
  routes,
});

export default router;
